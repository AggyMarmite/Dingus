<resources>
    <style name="Theme.Dingus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">?attr/dBg</item>
        <item name="android:colorAccent">?attr/dAccent</item>
        <item name="android:colorPrimary">?attr/dSurface</item>
        <item name="android:colorPrimaryDark">?attr/dBg</item>
        <item name="android:textColor">?attr/dText</item>
        <item name="android:textColorPrimary">?attr/dText</item>
        <item name="android:textColorSecondary">?attr/dMuted</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Midnight + blue unless changed in Settings -->
        <item name="dBg">#0B0E14</item>
        <item name="dSurface">#141923</item>
        <item name="dSurface2">#1C2330</item>
        <item name="dLine">#262E3D</item>
        <item name="dText">#E8ECF3</item>
        <item name="dMuted">#8B94A7</item>
        <item name="dAiring">#1A2130</item>
        <item name="dPast">#10141C</item>
        <item name="dAccent">#3B82F6</item>
        <item name="dAccentSoft">#263B82F6</item>
    </style>

    <!-- Backgrounds -->
    <style name="Bg.Midnight" parent="">
        <item name="dBg">#0B0E14</item><item name="dSurface">#141923</item><item name="dSurface2">#1C2330</item>
        <item name="dLine">#262E3D</item><item name="dText">#E8ECF3</item><item name="dMuted">#8B94A7</item>
        <item name="dAiring">#1A2130</item><item name="dPast">#10141C</item>
    </style>
    <style name="Bg.Slate" parent="">
        <item name="dBg">#1E2228</item><item name="dSurface">#272C34</item><item name="dSurface2">#323843</item>
        <item name="dLine">#3D4450</item><item name="dText">#F1F3F6</item><item name="dMuted">#A0A8B5</item>
        <item name="dAiring">#2E343E</item><item name="dPast">#22262D</item>
    </style>
    <style name="Bg.Black" parent="">
        <item name="dBg">#000000</item><item name="dSurface">#0D0D0F</item><item name="dSurface2">#18181C</item>
        <item name="dLine">#232328</item><item name="dText">#EDEDED</item><item name="dMuted">#8A8A92</item>
        <item name="dAiring">#141418</item><item name="dPast">#070708</item>
    </style>
    <style name="Bg.Plum" parent="">
        <item name="dBg">#120D18</item><item name="dSurface">#1B1424</item><item name="dSurface2">#251C31</item>
        <item name="dLine">#30253F</item><item name="dText">#EFEAF5</item><item name="dMuted">#9D93AC</item>
        <item name="dAiring">#221A2D</item><item name="dPast">#160F1D</item>
    </style>
    <style name="Bg.Forest" parent="">
        <item name="dBg">#0B1210</item><item name="dSurface">#121B18</item><item name="dSurface2">#1A2622</item>
        <item name="dLine">#24332E</item><item name="dText">#E8F2EE</item><item name="dMuted">#8CA39A</item>
        <item name="dAiring">#18231F</item><item name="dPast">#0E1613</item>
    </style>

    <!-- Accents -->
    <style name="Accent.Blue" parent=""><item name="dAccent">#3B82F6</item><item name="dAccentSoft">#263B82F6</item></style>
    <style name="Accent.Purple" parent=""><item name="dAccent">#8B5CF6</item><item name="dAccentSoft">#268B5CF6</item></style>
    <style name="Accent.Teal" parent=""><item name="dAccent">#14B8A6</item><item name="dAccentSoft">#2614B8A6</item></style>
    <style name="Accent.Green" parent=""><item name="dAccent">#22C55E</item><item name="dAccentSoft">#2622C55E</item></style>
    <style name="Accent.Orange" parent=""><item name="dAccent">#F97316</item><item name="dAccentSoft">#26F97316</item></style>
    <style name="Accent.Pink" parent=""><item name="dAccent">#EC4899</item><item name="dAccentSoft">#26EC4899</item></style>
    <style name="Accent.Red" parent=""><item name="dAccent">#EF4444</item><item name="dAccentSoft">#26EF4444</item></style>
    <style name="Accent.Gold" parent=""><item name="dAccent">#EAB308</item><item name="dAccentSoft">#26EAB308</item></style>
    <!-- Home, while Dingus starts: the logo straight away (swapped for the normal theme once it's running). -->
    <style name="Theme.Dingus.Launch">
        <item name="android:windowBackground">@drawable/launch_bg</item>
    </style>
    <style name="Theme.Dingus.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/dMuted</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/dText</item>
        <item name="android:textColorHint">#5B6477</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/pill_btn_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pill_text</item>
    </style>
    <style name="NavRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/dText</item>
    </style>
    <style name="SideRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/side_row_bg</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/dText</item>
    </style>
    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/dText</item>
    </style>
</resources>
