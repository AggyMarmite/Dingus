<?xml version="1.0" encoding="utf-8"?>
<!-- What shows over live TV: behind-live badge, messages, and the info bar (channel, now and next). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liveOverlay" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Behind live / paused -->
    <TextView android:id="@+id/shift" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="36dp" android:background="@drawable/badge_bg"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:visibility="gone" />

    <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:padding="12dp" android:textSize="14sp"
        android:textColor="?attr/dText" android:shadowColor="#000000" android:shadowRadius="6" />

    <!-- The info bar: shown when you change channel or press OK. -->
    <LinearLayout android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:background="@drawable/overlay_bg" android:visibility="gone"
        android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="70dp" android:paddingBottom="36dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="112dp" android:layout_height="64dp" android:background="@drawable/logo_bg">
                <TextView android:id="@+id/initials" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="?attr/dMuted" />
                <ImageView android:id="@+id/logo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>
            <TextView android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:textSize="26sp" android:textColor="?attr/dMuted" />
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp" android:maxLines="1" android:ellipsize="end"
                android:textSize="30sp" android:textStyle="bold" android:textColor="?attr/dText" />
            <TextView android:id="@+id/fav" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="★" android:textSize="26sp" android:textColor="#FBBF24" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/now" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:maxLines="1" android:ellipsize="end" android:textSize="24sp"
            android:textColor="?attr/dText" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/times" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="?attr/dMuted" />
            <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="16dp"
                android:max="1000" android:progressDrawable="@drawable/progress_track" />
        </LinearLayout>
        <TextView android:id="@+id/desc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textSize="16sp"
            android:textColor="?attr/dMuted" />
        <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="17sp"
            android:textColor="?attr/dText" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="▲ ▼  channel     ◀ ▶  rewind / forward     ⏯  pause     ≡  options     BACK  guide"
            android:textSize="14sp" android:textColor="?attr/dMuted" />
    </LinearLayout>
</FrameLayout>
