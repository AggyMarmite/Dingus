<?xml version="1.0" encoding="utf-8"?>
<!-- The guide: live preview (left) and what's highlighted (right) on top, the programme grid below,
     and the categories menu that slides in from the left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dBg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="230dp" android:orientation="horizontal"
            android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="24dp" android:paddingBottom="10dp">

            <FrameLayout android:id="@+id/previewBox" android:layout_width="350dp" android:layout_height="197dp"
                android:background="@drawable/logo_bg">
                <TextView android:id="@+id/previewText" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:padding="16dp" android:textSize="16sp" android:textColor="?attr/dMuted" />
                <!-- The player sits over this spot (see "stage" below) and grows to full screen from here. -->
            </FrameLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="30dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/infoChannel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="16sp"
                        android:textColor="?attr/dMuted" />
                    <TextView android:id="@+id/vpnBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp" android:textSize="13sp" android:textColor="#4ADE80" android:visibility="gone" />
                    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textColor="?attr/dMuted" />
                </LinearLayout>
                <TextView android:id="@+id/infoTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" android:textSize="28sp"
                    android:textStyle="bold" android:textColor="?attr/dText" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/infoTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textColor="?attr/dText" />
                    <ProgressBar android:id="@+id/infoProgress" style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="160dp" android:layout_height="4dp" android:layout_marginStart="14dp"
                        android:max="1000" android:progressDrawable="@drawable/progress_track" />
                    <TextView android:id="@+id/infoLive" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:text="ON NOW" android:textSize="12sp" android:textStyle="bold"
                        android:letterSpacing="0.08" android:textColor="@color/live" />
                </LinearLayout>
                <TextView android:id="@+id/infoDesc" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end"
                    android:textSize="15sp" android:lineSpacingExtra="2dp" android:textColor="?attr/dMuted" />
                <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:textSize="13sp" android:textColor="#5B6477"
                    android:text="OK  watch here  ·  OK again  full screen     ◀  categories     ◀ ◀  menu     ≡  channel options" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout android:id="@+id/guideArea" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <!-- Categories: LEFT from the guide opens this column to its left, moving the guide across. -->
            <LinearLayout android:id="@+id/catPanel" android:layout_width="250dp" android:layout_height="match_parent"
                android:orientation="vertical" android:background="?attr/dSurface"
                android:visibility="gone" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:text="CATEGORIES" android:textSize="12sp" android:textStyle="bold"
                    android:letterSpacing="0.08" android:textColor="?attr/dMuted" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:scrollbars="none" android:clipToPadding="false" android:paddingBottom="16dp"
                    android:descendantFocusability="afterDescendants" />
            </LinearLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <app.dingus.tv.GuideGrid android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:paddingStart="0dp" />
            <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:textSize="18sp"
                android:textColor="?attr/dMuted" android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The player: over the preview spot while browsing, the whole screen when watching. -->
    <FrameLayout android:id="@+id/stage" android:layout_width="350dp" android:layout_height="197dp" android:visibility="invisible">
        <androidx.media3.ui.PlayerView android:id="@+id/video"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false" app:resize_mode="fit" app:surface_type="surface_view"
            app:shutter_background_color="@android:color/black" />
        <include layout="@layout/layout_live_overlay" />
    </FrameLayout>

    <!-- Categories menu -->
    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99000000" android:visibility="gone" />
    <LinearLayout android:id="@+id/menu"
        android:layout_width="232dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="?attr/dSurface" android:elevation="12dp"
        android:visibility="gone"
        android:paddingStart="20dp" android:paddingEnd="14dp" android:paddingTop="26dp" android:paddingBottom="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_launcher"
                android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="Dingus" android:textSize="21sp" android:textStyle="bold"
                android:textColor="?attr/dText" />
        </LinearLayout>
        <!-- The playlist in use (OK to switch, when there's more than one) and the subscription. -->
        <TextView android:id="@+id/navPlaylist" style="@style/NavRow" android:layout_marginTop="6dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="?attr/dMuted"
            android:singleLine="true" android:ellipsize="end" android:nextFocusUp="@id/navPlaylist" android:nextFocusLeft="@id/navPlaylist" />
        <TextView android:id="@+id/navAccount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="8dp" android:textSize="12sp" android:textColor="?attr/dMuted"
            android:visibility="gone" />

        <TextView android:id="@+id/navHome" style="@style/NavRow" android:layout_marginTop="14dp" android:text="Home"
            android:drawableStart="@drawable/ic_home" android:nextFocusLeft="@id/navHome" />
        <TextView android:id="@+id/navGuide" style="@style/NavRow" android:text="Live TV" android:drawableStart="@drawable/ic_live_tv"
            android:nextFocusLeft="@id/navGuide" />
        <TextView android:id="@+id/navFilms" style="@style/NavRow" android:text="Films" android:drawableStart="@drawable/ic_film" />
        <TextView android:id="@+id/navShows" style="@style/NavRow" android:text="TV Shows" android:drawableStart="@drawable/ic_tv_shows" />
        <TextView android:id="@+id/navSearch" style="@style/NavRow" android:text="Search" android:drawableStart="@drawable/ic_search" />
        <TextView android:id="@+id/settings" style="@style/NavRow" android:text="Settings" android:drawableStart="@drawable/ic_settings"
            android:nextFocusLeft="@id/settings" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/navRefresh" style="@style/NavRow" android:text="Refresh playlist" android:textSize="14sp"
            android:drawableStart="@drawable/ic_refresh" android:nextFocusDown="@id/navRefresh" android:nextFocusLeft="@id/navRefresh" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:paddingStart="12dp" android:textSize="12sp" android:textColor="?attr/dMuted"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
