<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingTop="6dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/rowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingStart="48dp" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/dText" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowList" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:clipToPadding="false" android:paddingStart="42dp" android:paddingEnd="42dp"
        android:scrollbars="none" android:descendantFocusability="afterDescendants" />
</LinearLayout>
