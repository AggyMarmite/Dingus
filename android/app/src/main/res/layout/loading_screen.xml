<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the playlist is first read or loaded: no menu, a soft glow, the Dingus logo, a thin moving line
     and what's happening. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loadingScreen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/dBg" android:clickable="true">
    <View android:id="@+id/loadingGlow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="92dp" android:layout_height="92dp" android:src="@drawable/ic_launcher"
            android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Dingus" android:textSize="30sp" android:textStyle="bold" android:textColor="?attr/dText" />
        <ProgressBar android:id="@+id/loadingLine" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="220dp" android:layout_height="4dp" android:layout_marginTop="26dp"
            android:indeterminate="true" android:indeterminateTint="#FFFFFFFF" android:progressBackgroundTint="#33FFFFFF" />
        <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Getting your channels ready…" android:textSize="14sp"
            android:textColor="?attr/dMuted" android:gravity="center" />
    </LinearLayout>
</FrameLayout>
