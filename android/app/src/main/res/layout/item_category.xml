<?xml version="1.0" encoding="utf-8"?>
<!-- A category in a column: a pill (white when highlighted, soft for the one showing), its count on the right. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="36dp"
    android:layout_marginBottom="3dp" android:background="@drawable/cat_pill_bg"
    android:focusable="true" android:clickable="true" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:drawablePadding="8dp"
    android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/pill_text" />
