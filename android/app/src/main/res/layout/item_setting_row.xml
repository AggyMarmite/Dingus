<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings row: name (and a short note), its value on the right, and a switch for on/off ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"
    android:background="@drawable/button_bg" android:focusable="true" android:clickable="true" android:minHeight="52dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="9dp" android:paddingBottom="9dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:duplicateParentState="true" android:textColor="@color/pill_text" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="14sp" android:duplicateParentState="true" android:textColor="@color/sub_text" />
    </LinearLayout>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:maxWidth="320dp" android:maxLines="1" android:ellipsize="end"
        android:textSize="13sp" android:duplicateParentState="true" android:textColor="@color/chip_text"
        android:background="@drawable/value_chip" android:visibility="gone" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    <ImageView android:id="@+id/switchIcon" android:layout_width="40dp" android:layout_height="22dp" android:layout_marginStart="16dp"
        android:duplicateParentState="true" android:contentDescription="@null" android:visibility="gone" />
</LinearLayout>
