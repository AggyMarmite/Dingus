<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings row: name (and a short note), its value on the right, and a switch for on/off ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:background="@drawable/button_bg" android:focusable="true" android:clickable="true" android:minHeight="58dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="?attr/dText" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="14sp" android:duplicateParentState="true" android:textColor="@color/sub_text" />
    </LinearLayout>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:maxWidth="320dp" android:maxLines="1" android:ellipsize="end"
        android:textSize="16sp" android:duplicateParentState="true" android:textColor="@color/sub_text" />
    <ImageView android:id="@+id/switchIcon" android:layout_width="46dp" android:layout_height="26dp" android:layout_marginStart="16dp"
        android:duplicateParentState="true" android:contentDescription="@null" android:visibility="gone" />
</LinearLayout>
