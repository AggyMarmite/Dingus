<?xml version="1.0" encoding="utf-8"?>
<!-- The highlighted title or channel: artwork behind, details on the left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="250dp">
    <ImageView android:id="@+id/heroArt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:alpha="0.55" android:contentDescription="@null" />
    <View android:id="@+id/heroShade" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/heroBody" android:layout_width="620dp" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="48dp" android:paddingTop="14dp" android:gravity="top" android:paddingBottom="6dp">
        <TextView android:id="@+id/heroKicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="?attr/dAccent" />
        <ImageView android:id="@+id/heroLogo" android:layout_width="wrap_content" android:layout_height="84dp"
            android:layout_marginTop="2dp" android:maxWidth="420dp" android:adjustViewBounds="true" android:scaleType="fitStart"
            android:contentDescription="@null" android:visibility="gone" />
        <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="32sp"
            android:textStyle="bold" android:textColor="?attr/dText" />
        <TextView android:id="@+id/heroMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="15sp"
            android:textColor="?attr/dMuted" />
        <TextView android:id="@+id/heroText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="4" android:ellipsize="end" android:textSize="15sp"
            android:lineSpacingExtra="2dp" android:textColor="?attr/dText" />
    </LinearLayout>
</FrameLayout>
