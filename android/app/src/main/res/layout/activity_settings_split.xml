<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the sections down the left, the highlighted section's options on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="?attr/dBg">
    <LinearLayout android:layout_width="290dp" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="30dp" android:paddingEnd="16dp" android:paddingTop="36dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="14dp"
            android:text="Settings" android:textSize="30sp" android:textStyle="bold" android:textColor="?attr/dText" />
        <LinearLayout android:id="@+id/sections" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:orientation="vertical" />
    </LinearLayout>
    <ScrollView android:id="@+id/pane" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false"
        android:paddingStart="10dp" android:paddingEnd="56dp" android:paddingTop="40dp" android:paddingBottom="40dp">
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
