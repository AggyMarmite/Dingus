<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the sections down the left as pills (white when highlighted, soft for the one open), the open
     section's settings on the right as cards. A soft glow behind, the time top right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dBg">
    <View android:id="@+id/settingsGlow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <LinearLayout android:layout_width="270dp" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="30dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp"
                android:text="Settings" android:textSize="26sp" android:textStyle="bold" android:textColor="?attr/dText" />
            <TextView android:id="@+id/settingsSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"
                android:textSize="12sp" android:textColor="?attr/dMuted" />
            <LinearLayout android:id="@+id/sections" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:orientation="vertical" />
        </LinearLayout>
        <ScrollView android:id="@+id/pane" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false"
            android:paddingStart="10dp" android:paddingEnd="48dp" android:paddingTop="26dp" android:paddingBottom="40dp">
            <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="22dp" android:layout_marginEnd="48dp"
        android:textSize="16sp" android:textColor="?attr/dMuted" />
</FrameLayout>
