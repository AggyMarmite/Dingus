<?xml version="1.0" encoding="utf-8"?>
<!-- An actor on a film's page: round photo, name, part. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="124dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp"
    android:background="@drawable/button_bg" android:focusable="true" android:clickable="true">
    <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
        <TextView android:id="@+id/initials" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="?attr/dMuted" />
        <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:contentDescription="@null" />
    </FrameLayout>
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
        android:textSize="13sp" android:textColor="?attr/dText" />
    <TextView android:id="@+id/role" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textSize="11sp"
        android:duplicateParentState="true" android:textColor="@color/sub_text" />
</LinearLayout>
