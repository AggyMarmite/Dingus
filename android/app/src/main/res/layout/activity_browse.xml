<?xml version="1.0" encoding="utf-8"?>
<!-- Films or TV shows: a banner for the highlighted title over rows (Featured) or a poster grid (a category).
     LEFT at the edge brings in the categories panel, like Live TV. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dBg">
    <!-- Like Home: the highlighted title's picture behind the whole screen (a soft glow in a category). -->
    <View android:id="@+id/browseGlow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/browseArt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <View android:id="@+id/browseShade" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@+id/browseDim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?attr/dBg" android:alpha="0" />
    <LinearLayout android:id="@+id/browseRoot" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- The categories: part of the screen (like Live TV's). Moving up and down shows each one's titles beside it;
             RIGHT goes into them and the column folds away, LEFT from the first title brings it back. -->
        <LinearLayout android:id="@+id/catPanel" android:layout_width="240dp" android:layout_height="match_parent"
            android:layout_marginTop="70dp" android:layout_marginEnd="6dp"
            android:orientation="vertical" android:background="@drawable/cat_panel_bg" android:visibility="gone"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp">
            <TextView android:id="@+id/heading" android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center_vertical" android:paddingStart="12dp" android:textSize="11sp" android:textStyle="bold"
                android:letterSpacing="0.12" android:textAllCaps="true" android:textColor="?attr/dMuted" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <include layout="@layout/hero" />
                <!-- Featured: which screen this is, top left (the clock's on the right). -->
                <TextView android:id="@+id/screenName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|start" android:layout_marginStart="48dp" android:layout_marginTop="22dp"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/dText" />
                <!-- In a category (no banner): its name and how many. -->
                <LinearLayout android:id="@+id/gridHead" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="44dp" android:layout_marginTop="26dp" android:layout_marginBottom="10dp"
                    android:orientation="horizontal" android:gravity="bottom" android:visibility="gone">
                    <TextView android:id="@+id/gridTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textSize="26sp" android:textStyle="bold"
                        android:textColor="?attr/dText" />
                    <TextView android:id="@+id/gridCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_marginBottom="3dp" android:textSize="15sp"
                        android:textColor="?attr/dMuted" />
                </LinearLayout>
                <TextView android:id="@+id/crumb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|end" android:layout_marginTop="22dp" android:layout_marginEnd="48dp"
                    android:maxLines="1" android:textSize="18sp" android:textColor="?attr/dMuted" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="60dp"
                    android:scrollbars="none" android:descendantFocusability="afterDescendants" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false" android:visibility="gone"
                    android:paddingStart="40dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="40dp"
                    android:scrollbars="none" android:descendantFocusability="afterDescendants" />
                <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:textSize="18sp"
                    android:textColor="?attr/dMuted" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
