<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a banner for what's highlighted, then rows – continue watching, favourite channels, what's new. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dBg">
    <!-- The feature's picture fills the whole screen, behind everything (the rows scroll up over it). -->
    <!-- The picture behind and its shading, drawn once as one layer (not again on every frame while scrolling). -->
    <FrameLayout android:id="@+id/homeBack" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layerType="hardware">
    <View android:id="@+id/homeGlow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/homeArt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <View android:id="@+id/homeShade" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@+id/homeDim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?attr/dBg" android:alpha="0" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/hero" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="60dp"
            android:scrollbars="none" android:descendantFocusability="afterDescendants" />
    </LinearLayout>
    <!-- Under the clock once the rows have scrolled up (the rows fade out beneath it). -->
    <View android:id="@+id/topFade" android:layout_width="match_parent" android:layout_height="20dp"
        android:visibility="gone" />
    <!-- The clock (and the VPN's state), top right. The menu is down the left (SideMenu). -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="22dp" android:paddingEnd="48dp">
        <TextView android:id="@+id/vpnBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="18dp" android:textSize="14sp" android:textColor="#4ADE80" android:visibility="gone" />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="?attr/dMuted" />
    </LinearLayout>
    <include layout="@layout/loading_screen" />
    <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:layout_marginTop="80dp" android:gravity="center" android:textSize="18sp"
        android:textColor="?attr/dMuted" android:visibility="gone" />
</FrameLayout>
