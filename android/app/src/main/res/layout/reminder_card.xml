<?xml version="1.0" encoding="utf-8"?>
<!-- A programme reminder while Dingus is open: small, in the corner (Reminders.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/reminder_bg" android:elevation="12dp"
    android:padding="10dp">
    <FrameLayout android:layout_width="64dp" android:layout_height="36dp" android:background="@drawable/logo_bg">
        <TextView android:id="@+id/remInitials" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="?attr/dMuted" />
        <ImageView android:id="@+id/remLogo" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="4dp" android:scaleType="fitCenter" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:layout_width="190dp" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp">
        <TextView android:id="@+id/remWhen" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#F87171" />
        <TextView android:id="@+id/remTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/remChannel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="#AAB3C4" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/remWatch" android:layout_width="96dp" android:layout_height="30dp"
            android:background="@drawable/reminder_btn" android:focusable="true" android:clickable="true"
            android:gravity="center" android:text="▶  Watch" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/reminder_btn_text" android:nextFocusDown="@+id/remDismiss" />
        <TextView android:id="@+id/remDismiss" android:layout_width="96dp" android:layout_height="30dp"
            android:layout_marginTop="6dp" android:background="@drawable/reminder_btn" android:focusable="true"
            android:clickable="true" android:gravity="center" android:text="Dismiss" android:textSize="13sp"
            android:textStyle="bold" android:textColor="@color/reminder_btn_text" android:nextFocusUp="@id/remWatch" />
    </LinearLayout>
</LinearLayout>
