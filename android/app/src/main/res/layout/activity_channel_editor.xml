<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="?attr/dBg">
    <LinearLayout android:layout_width="290dp" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="14dp"
            android:text="Edit channels" android:textSize="26sp" android:textStyle="bold" android:textColor="?attr/dText" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:text="OK on a channel to rename, renumber or hide it."
            android:textSize="14sp" android:textColor="?attr/dMuted" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="40dp" android:paddingTop="28dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="22sp" android:textStyle="bold" android:textColor="?attr/dText" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:clipToPadding="false"
            android:paddingBottom="30dp" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
    </LinearLayout>
</LinearLayout>
