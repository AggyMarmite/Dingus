<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:background="@drawable/button_bg" android:focusable="true" android:clickable="true"
    android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="14dp" android:paddingBottom="14dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textColor="?attr/dText" />
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="15sp" android:duplicateParentState="true" android:textColor="@color/sub_text" />
</LinearLayout>
