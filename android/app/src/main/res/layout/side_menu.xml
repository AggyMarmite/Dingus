<?xml version="1.0" encoding="utf-8"?>
<!-- The side menu on every screen, Apple TV style. Closed: a slim frosted strip of icons floating on the left, with
     the clock (and the VPN's shield) above it. LEFT opens it: the strip grows into a rounded frosted panel floating
     over the screen (SideMenu.kt draws the glass and moves it), the names slide in one after another, and the
     playlist and the VPN appear at the top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sideMenu" android:layout_width="260dp" android:layout_height="match_parent"
    android:clickable="true" android:clipChildren="false">

    <LinearLayout android:id="@+id/sideColumn" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="22dp" android:clipChildren="false"
        android:clipToPadding="false">

        <!-- The top: the clock and the VPN's shield while it's closed; the logo, the playlist and its status when open. -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="64dp" android:clipChildren="false">
            <!-- (Over the strip, the shield under the clock: it fits in the strip's width, clear of the page's own title.) -->
            <LinearLayout android:id="@+id/sideClockRow" android:layout_width="60dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/sideClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/dText"
                    android:shadowColor="#99000000" android:shadowRadius="6" android:shadowDy="1" />
                <TextView android:id="@+id/sideVpn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="center" android:textSize="13sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/sideHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="16dp"
                android:layout_marginTop="4dp" android:clipChildren="false">
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_launcher"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:orientation="vertical" android:clipChildren="false">
                    <TextView android:id="@+id/sideName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Dingus" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/dText" />
                    <!-- The playlist in use and whether it's online (OK to switch, when there's more than one). -->
                    <TextView android:id="@+id/navPlaylist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp" android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="1dp"
                        android:paddingBottom="1dp" android:textSize="13sp" android:textColor="?attr/dMuted" android:singleLine="true"
                        android:ellipsize="end" android:focusable="false" android:clickable="true"
                        android:background="@drawable/side_playlist_bg" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <!-- (The subscription's details now live in Settings → Playlist.) -->
        <TextView android:id="@+id/navAccount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <!-- The VPN once it's on (or connecting, or dropped): "VPN on · US – Boston". -->
        <TextView android:id="@+id/sideVpnPlace" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="18dp" android:layout_marginTop="2dp"
            android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:drawablePadding="8dp" android:gravity="center_vertical" android:textSize="13sp" android:singleLine="true"
            android:ellipsize="end" android:visibility="gone" />

        <TextView android:id="@+id/navHome" style="@style/SideRow" android:layout_marginTop="12dp" android:text="Home"
            android:drawableStart="@drawable/ic_home" />
        <TextView android:id="@+id/navGuide" style="@style/SideRow" android:text="Live TV" android:drawableStart="@drawable/ic_live_tv" />
        <TextView android:id="@+id/navFilms" style="@style/SideRow" android:text="Films" android:drawableStart="@drawable/ic_film" />
        <TextView android:id="@+id/navShows" style="@style/SideRow" android:text="TV Shows" android:drawableStart="@drawable/ic_tv_shows" />
        <TextView android:id="@+id/navSearch" style="@style/SideRow" android:text="Search" android:drawableStart="@drawable/ic_search" />
        <TextView android:id="@+id/settings" style="@style/SideRow" android:text="Settings" android:drawableStart="@drawable/ic_settings"
            android:nextFocusDown="@+id/navRefresh" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <View android:id="@+id/sideLine" android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginBottom="8dp" android:background="#14FFFFFF" />
        <TextView android:id="@id/navRefresh" style="@style/SideRow" android:text="Refresh playlist" android:textSize="14sp"
            android:drawableStart="@drawable/ic_refresh" android:nextFocusUp="@id/settings" android:nextFocusDown="@id/navRefresh" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:paddingStart="24dp" android:paddingEnd="16dp" android:textSize="12sp"
            android:textColor="?attr/dMuted" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
