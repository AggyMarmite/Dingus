<?xml version="1.0" encoding="utf-8"?>
<!-- Search: the box, Voice search (opens the Fire TV keyboard just for speaking) and a built-in keyboard on the left;
     results on the right, changing with every letter. Before you type: your recent searches. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/dBg">
    <View android:id="@+id/searchGlow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingTop="30dp">
        <LinearLayout android:layout_width="250dp" android:layout_height="match_parent" android:orientation="vertical">
            <EditText android:id="@+id/query" android:layout_width="match_parent" android:layout_height="44dp"
                android:background="@drawable/search_box" android:paddingStart="18dp" android:paddingEnd="14dp"
                android:singleLine="true" android:textSize="17sp" android:textStyle="bold" android:textColor="?attr/dText"
                android:textColorHint="#6B7488" android:hint="Search everything" android:inputType="text"
                android:imeOptions="actionSearch" android:focusable="false" android:focusableInTouchMode="false" />
            <TextView android:id="@+id/voice" android:layout_width="match_parent" android:layout_height="42dp"
                android:layout_marginTop="12dp" android:background="@drawable/pill_btn_bg" android:focusable="true"
                android:clickable="true" android:gravity="center" android:text="🎤  Voice search" android:textSize="15sp"
                android:textStyle="bold" android:textColor="@color/pill_text" />
            <GridLayout android:id="@+id/keys" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:columnCount="6" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:orientation="horizontal">
                <TextView android:id="@+id/keySpace" style="@style/SearchKeyWide" android:text="␣ space" />
                <TextView android:id="@+id/keyDelete" style="@style/SearchKeyWide" android:text="⌫ delete" />
                <TextView android:id="@+id/keyClear" style="@style/SearchKeyWide" android:text="clear" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="30dp" android:paddingEnd="48dp">
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="13sp" android:textColor="?attr/dMuted" />
            <LinearLayout android:id="@+id/recentBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Recent searches" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/dText" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/recent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/results"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="4dp" android:clipToPadding="false" android:paddingBottom="30dp"
                android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="22dp" android:layout_marginEnd="48dp"
        android:textSize="16sp" android:textColor="?attr/dMuted" />
</FrameLayout>
