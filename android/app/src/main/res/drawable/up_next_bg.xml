<?xml version="1.0" encoding="utf-8"?>
<!-- The "Up next" card: a white edge when the remote's on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#F0141923" /><corners android:radius="16dp" />
        <stroke android:width="3dp" android:color="#FFFFFFFF" /></shape></item>
    <item><shape><solid android:color="#F0141923" /><corners android:radius="16dp" /></shape></item>
</selector>
