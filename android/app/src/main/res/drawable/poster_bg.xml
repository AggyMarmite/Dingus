<?xml version="1.0" encoding="utf-8"?>
<!-- A poster: a bright frame when the remote is on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="?attr/dSurface2" /><corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item><shape><solid android:color="?attr/dSurface" /><corners android:radius="10dp" /></shape></item>
</selector>
