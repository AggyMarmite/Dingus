<?xml version="1.0" encoding="utf-8"?>
<!-- A text box: a soft rounded field, a white edge when the remote's on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#D91E2636" /><corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item><shape><solid android:color="#B31E2636" /><corners android:radius="14dp" /></shape></item>
</selector>
