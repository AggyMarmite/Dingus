<?xml version="1.0" encoding="utf-8"?>
<!-- The reminder card's buttons: white when highlighted, a soft pill otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#FFFFFF" /><corners android:radius="15dp" /></shape></item>
    <item><shape><solid android:color="#24FFFFFF" /><corners android:radius="15dp" /></shape></item>
</selector>
