    <item android:state_focused="true"><shape><solid android:color="#FF0B0E14" /><corners android:radius="13dp" /></shape></item>
    <item><shape><solid android:color="#17FFFFFF" /><corners android:radius="13dp" /></shape></item>
</selector>
