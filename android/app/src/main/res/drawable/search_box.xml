<?xml version="1.0" encoding="utf-8"?>
<!-- The search box: a soft pill, a white edge while you're typing or speaking into it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#D91E2636" /><corners android:radius="22dp" />
        <stroke android:width="2dp" android:color="#FFFFFFFF" /></shape></item>
    <item><shape><solid android:color="#CC1E2636" /><corners android:radius="22dp" /></shape></item>
</selector>
