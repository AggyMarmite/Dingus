<?xml version="1.0" encoding="utf-8"?>
<!-- A category (or section) in a column: white when the remote is on it, a soft fill for the one showing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#26FFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="18dp" /></shape></item>
</selector>
