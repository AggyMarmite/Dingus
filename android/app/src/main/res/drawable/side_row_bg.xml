<?xml version="1.0" encoding="utf-8"?>
<!-- A row in the side menu: solid when the remote is on it, soft for the screen you're on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="?attr/dAccent" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="?attr/dAccentSoft" /><corners android:radius="10dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" /></shape></item>
</selector>
