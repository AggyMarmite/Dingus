<?xml version="1.0" encoding="utf-8"?>
<!-- A row in a list: a clear highlight when the remote is on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/accent_soft" /><corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/accent" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" /></shape></item>
</selector>
