<?xml version="1.0" encoding="utf-8"?>
<!-- A pill button: white when the remote is on it, brighter for "on"/chosen, a soft fill otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#40FFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item><shape><solid android:color="#26FFFFFF" /><corners android:radius="24dp" /></shape></item>
</selector>
