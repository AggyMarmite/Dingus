<?xml version="1.0" encoding="utf-8"?>
<!-- An "off" switch: grey track, knob on the left (darker track on the white highlighted row). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list>
        <item><shape><solid android:color="#FFC9CED8" /><corners android:radius="11dp" /><size android:width="40dp" android:height="22dp" /></shape></item>
        <item android:left="3dp" android:top="3dp" android:right="21dp" android:bottom="3dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item><shape><solid android:color="#2EFFFFFF" /><corners android:radius="11dp" /><size android:width="40dp" android:height="22dp" /></shape></item>
        <item android:left="3dp" android:top="3dp" android:right="21dp" android:bottom="3dp"><shape android:shape="oval"><solid android:color="#FFCFD6E4" /></shape></item>
    </layer-list></item>
</selector>
