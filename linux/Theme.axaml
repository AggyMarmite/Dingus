<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================================== -->
    <!-- Dingus's look on Linux: the same dark palette, buttons, tabs and lists as on Windows. -->
    <!-- ===================================================================================== -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="4,26,0,10"/>
    </Style>
    <Style Selector="TextBlock.field">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ============ Buttons ============ -->
    <Style Selector="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    <Border Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                        <Border.Transitions>
                            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="CP" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Hover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button:pressed /template/ Border#Hover">
        <Setter Property="Background" Value="{StaticResource PressBrush}"/>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#Hover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="#FCA5A5"/>
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.overlay">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style Selector="Button.text">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>

    <!-- Window buttons in the title bar -->
    <Style Selector="Button.caption">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.caption:pressed">
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.captionClose:pointerover /template/ Border#Hover">
        <Setter Property="Background" Value="#E81123"/>
    </Style>

    <!-- Cards that lift slightly on hover (posters, channel cards) -->
    <Style Selector="Button.card">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Hover" Margin="-6" CornerRadius="14" Background="{StaticResource HoverBrush}" Opacity="0">
                        <Border.Transitions>
                            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="CP" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.card:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.card:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- ============ Title bar tabs ============ -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="HoverBg" CornerRadius="7" Background="{StaticResource HoverBrush}" Opacity="0">
                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions></Border.Transitions>
                    </Border>
                    <Border Name="OnBg" CornerRadius="7" Background="{StaticResource Surface3Brush}" Opacity="0">
                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16"/></Transitions></Border.Transitions>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,6,14,6">
                        <TextBlock Name="Icon" Classes="icon" FontSize="15"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ Border#HoverBg">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="RadioButton.tab:checked">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#OnBg">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ TextBlock#Icon">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <!-- Narrow windows: icons only -->
    <Style Selector="RadioButton.tab.compact /template/ ContentPresenter#Label">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="RadioButton.tab.compact /template/ StackPanel">
        <Setter Property="Margin" Value="10,6"/>
    </Style>
    <Style Selector="RadioButton.tabIcon /template/ ContentPresenter#Label">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="RadioButton.tabIcon /template/ StackPanel">
        <Setter Property="Margin" Value="9,8"/>
    </Style>

    <!-- Small pill choices (Guide · On now · Tonight, filters) -->
    <Style Selector="RadioButton.chip">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="B" CornerRadius="14" Padding="12,5" Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Border.Transitions><Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions></Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.chip:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.chip:checked">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ Border#B">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ============ Lists ============ -->
    <Style Selector="ListBox.clean">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#24406F"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.clean ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PressBrush}"/>
    </Style>

    <!-- Categories: rounded rows with a little inset -->
    <Style Selector="ListBox.categories ListBoxItem">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="10,1"/>
    </Style>
    <Style Selector="ListBox.categories ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ListBox.categories ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============ Progress & sliders ============ -->
    <Style Selector="ProgressBar.thin">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
    </Style>

    <Style Selector="Slider.player">
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#55FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#77FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#77FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3B82F6"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#60A5FA"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#60A5FA"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ============ Text boxes ============ -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============ Scroll bars: thin, out of the way ============ -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="True"/>
    </Style>

    <!-- ============ Toggle switches (settings) ============ -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
    </Style>

    <!-- ============ Menus ============ -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</Styles>
