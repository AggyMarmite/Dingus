<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             xmlns:local="clr-namespace:Dingus"
             x:Class="Dingus.Views.EventsView">
    <UserControl.Resources>
        <!-- One game: kick-off (or LIVE), the teams, where it's on; Watch or Remind me -->
        <DataTemplate x:Key="GameRow">
            <Border Classes="eventRow" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" PointerReleased="Game_PointerReleased">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="primary" Margin="8,0,0,0" Click="Watch_Click" IsVisible="{Binding IsLive}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static local:Icons.Play}"/>
                                <TextBlock Text="Watch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="Remind_Click" IsVisible="{Binding IsUpcoming}"
                                ToolTip.Tip="A reminder pops up just before kick-off, with a button to watch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Panel>
                                    <TextBlock Classes="icon" Text="{x:Static local:Icons.Bell}" IsVisible="{Binding !HasReminder}"/>
                                    <TextBlock Classes="icon" Text="{x:Static local:Icons.BellRing}" Foreground="{StaticResource AccentBrush}"
                                               IsVisible="{Binding HasReminder}"/>
                                </Panel>
                                <TextBlock Text="{Binding RemindText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- kick-off -->
                    <StackPanel DockPanel.Dock="Left" Width="92" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="7,2" Background="#E5484D" IsVisible="{Binding IsLive}">
                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="17" FontWeight="SemiBold" IsVisible="{Binding IsUpcoming}"/>
                        <TextBlock Text="{Binding DayText}" FontSize="12" Classes="muted" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.eventRow:pointerover">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
        <StackPanel Margin="36,16,36,48" MaxWidth="1000">

            <TextBlock Text="Events" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Find a game in your TV guide, or follow your teams to see when they're on."/>

            <!-- Find a game -->
            <Panel Margin="0,18,0,0">
                <TextBox x:Name="QueryBox" Watermark="Find a game – e.g. Arsenal v Chelsea" FontSize="15" Padding="40,10,12,10"
                         TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"/>
                <TextBlock Classes="icon muted" Text="{x:Static local:Icons.Search}" FontSize="17" Margin="14,0,0,0" HorizontalAlignment="Left"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Panel>

            <!-- Search results -->
            <StackPanel x:Name="ResultsPart" IsVisible="False">
                <TextBlock x:Name="ResultsHeader" Classes="section" Text="IN YOUR TV GUIDE"/>
                <ItemsControl x:Name="ResultList" ItemTemplate="{StaticResource GameRow}"/>
                <TextBlock x:Name="ResultsEmpty" Classes="muted" Margin="2,0,0,0" TextWrapping="Wrap" IsVisible="False"/>
                <StackPanel x:Name="ChannelsPart" IsVisible="False">
                    <TextBlock Classes="section" Text="EVENT CHANNELS"/>
                    <ItemsControl x:Name="ChannelResults">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="EventChannel_Click"
                                        Margin="0,0,0,2" ToolTip.Tip="Watch this channel">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Classes="icon" Text="{x:Static local:Icons.Play}" FontSize="15"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Now}" Classes="muted" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Your teams -->
            <StackPanel x:Name="TeamsPart">
                <TextBlock Classes="section" Text="YOUR TEAMS"/>
                <ItemsControl x:Name="TeamChips">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="14,4,4,4" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Classes="ghost" Padding="6,2" Margin="6,0,0,0" Click="Unfollow_Click" ToolTip.Tip="Unfollow">
                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Close}" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="8">
                    <TextBox x:Name="FollowBox" Watermark="Add a team – e.g. Arsenal" Width="300" KeyDown="FollowBox_KeyDown"/>
                    <Button Classes="primary" Content="Follow" Click="Follow_Click"/>
                </StackPanel>
                <CheckBox x:Name="RemindAllToggle" Classes="toggle" Margin="0,16,0,0" IsCheckedChanged="RemindAll_Changed">
                    <StackPanel>
                        <TextBlock Text="Remind me before every game" FontWeight="SemiBold"/>
                        <TextBlock Text="Reminders are set by themselves as your teams' games appear in the TV guide."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>

                <TextBlock Classes="section" Text="COMING UP FOR YOUR TEAMS"/>
                <ItemsControl x:Name="TeamGames" ItemTemplate="{StaticResource GameRow}"/>
                <TextBlock x:Name="TeamEmpty" Classes="muted" Margin="2,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
