<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             xmlns:local="clr-namespace:Dingus"
             xmlns:views="clr-namespace:Dingus.Views"
             x:Class="Dingus.Views.LibraryView">
    <Grid ColumnDefinitions="232,*">

        <!-- ===== Categories ===== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,10,4">
                    <Button x:Name="ReorderButton" DockPanel.Dock="Right" Classes="ghost" Content="Reorder" FontSize="11" Padding="8,3"
                            Click="Reorder_Click" ToolTip.Tip="Change the order of the categories (you can also right-click one)"/>
                    <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="SemiBold" Classes="muted" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="CategoryList" Classes="clean categories" SelectionChanged="CategoryList_SelectionChanged" Padding="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- Reorder mode: move this category up or down -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsVisible="{Binding ShowArrows}" Margin="6,-5,-10,-5">
                                    <Button Classes="icon" Content="{x:Static local:Icons.ChevronUp}" Width="26" Height="26" FontSize="16"
                                            Click="CatUp_Click" ToolTip.Tip="Move up"/>
                                    <Button Classes="icon" Content="{x:Static local:Icons.ChevronDown}" Width="26" Height="26" FontSize="16"
                                            Click="CatDown_Click" ToolTip.Tip="Move down"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Poster grid ===== -->
        <Grid x:Name="BrowsePane" Grid.Column="1" RowDefinitions="Auto,*">
            <DockPanel Margin="28,18,28,10">
                <StackPanel x:Name="SortPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SortAdded" Classes="chip" GroupName="Sort" Content="Recently added" Tag="added" IsCheckedChanged="Sort_Checked"/>
                    <RadioButton x:Name="SortName" Classes="chip" GroupName="Sort" Content="A–Z" Tag="name" IsCheckedChanged="Sort_Checked"/>
                    <RadioButton x:Name="SortRating" Classes="chip" GroupName="Sort" Content="Top rated" Tag="rating" IsCheckedChanged="Sort_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" FontSize="13" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,3"/>
                </StackPanel>
            </DockPanel>

            <ListBox x:Name="PosterList" Grid.Row="1" Classes="clean plain" Padding="20,4,8,24" Focusable="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="card" Width="156" Margin="8,8,8,14" Click="Poster_Click" ToolTip.Tip="{Binding Title}"
                                            PointerReleased="Poster_PointerReleased">
                                        <StackPanel>
                                            <Border Width="156" Height="234" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                                               VerticalAlignment="Center" Classes="muted" FontSize="12"/>
                                                    <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                                                    <!-- Age rating and score -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" CornerRadius="4" Padding="5,1,5,2"
                                                            Background="#99000000" IsVisible="{Binding HasAge}">
                                                        <TextBlock Text="{Binding Age}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" CornerRadius="4" Padding="5,1,6,2"
                                                            Background="#B3062B36" IsVisible="{Binding HasScore}">
                                                        <TextBlock Text="{Binding Score, StringFormat='★ {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#7FDCF5"/>
                                                    </Border>
                                                    <!-- On My List -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,12" Width="26" Height="26"
                                                            CornerRadius="13" Background="#CC0A0D13" IsVisible="{Binding Saved}" ToolTip.Tip="On My List">
                                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Check}" FontSize="14" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Bottom" Height="5" Background="#99000000" IsVisible="{Binding HasProgress}">
                                                        <ProgressBar Classes="thin" Value="{Binding Progress, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center" Height="3"/>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Films / TV Shows "Home": rows of wide title-art cards -->
            <ScrollViewer x:Name="RowsPane" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="False" svc:SmoothScroll.Enabled="True">
                <ItemsControl x:Name="RowsList" Margin="20,0,8,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Margin="8,4,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Panel Margin="8,0,8,6">
                                                    <TextBlock Text="{Binding Number}" FontSize="96" FontWeight="Black" Foreground="#24FFFFFF"
                                                               Margin="-6,-30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsVisible="{Binding HasNumber}"/>
                                                    <Button Classes="card" Width="272" Click="Wide_Click" ToolTip.Tip="{Binding Title}"
                                                            Margin="{Binding HasNumber, Converter={x:Static views:Converters.NumberedMargin}}">
                                                        <Border Width="272" Height="153" CornerRadius="9" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                                                            <Panel>
                                                                <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="420" svc:ImageLoader.Url="{Binding Image}"/>
                                                                <Rectangle>
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                            <GradientStop Color="#000A0D13" Offset="0.35"/>
                                                                            <GradientStop Color="#E00A0D13" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <Image svc:ImageLoader.Url="{Binding Logo}" svc:ImageLoader.DecodeWidth="360" Stretch="Uniform"
                                                                       MaxHeight="58" MaxWidth="190" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                                                                       IsVisible="{Binding HasLogo}"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                                                                           MaxHeight="44" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="12,0,12,11"
                                                                           IsVisible="{Binding !HasLogo}"/>
                                                            </Panel>
                                                        </Border>
                                                    </Button>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" MaxWidth="520">
                <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyBody" Classes="muted" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== Details (film or show) ===== -->
        <Panel x:Name="DetailPane" Grid.Column="1" Background="{StaticResource BgBrush}" IsVisible="False" ClipToBounds="True">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="560" Opacity="0.7" svc:ImageLoader.DecodeWidth="960"/>
            <Rectangle Height="560" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#000A0D13" Offset="0.45"/>
                        <GradientStop Color="#FF0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#E00A0D13" Offset="0"/>
                        <GradientStop Color="#000A0D13" Offset="0.8"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="40,20,40,40">
                    <Button Classes="ghost" HorizontalAlignment="Left" Click="Back_Click" Margin="-12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="{x:Static local:Icons.Back}"/>
                            <TextBlock x:Name="BackText" Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,18,0,0" ColumnDefinitions="Auto,*">
                        <Border x:Name="PosterBox" Width="220" Height="330" VerticalAlignment="Top" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Surface2Brush}" IsVisible="False">
                            <Image x:Name="DetailPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="330"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,30,0,0">
                            <TextBlock x:Name="DetailTitle" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left"/>
                            <Image x:Name="DetailLogo" Stretch="Uniform" MaxHeight="140" MaxWidth="460" HorizontalAlignment="Left" IsVisible="False"
                                   svc:ImageLoader.DecodeWidth="920"/>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock x:Name="DetailMeta" FontSize="14" FontWeight="SemiBold" Foreground="#DFE5EE" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border x:Name="AgeTag" CornerRadius="4" Padding="6,2" Background="#29FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="False">
                                    <TextBlock x:Name="AgeText" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border x:Name="ScoreTag" CornerRadius="4" Padding="7,2" Background="#2E01B4E4" VerticalAlignment="Center" IsVisible="False">
                                    <TextBlock x:Name="ScoreText" FontSize="12" FontWeight="Bold" Foreground="#7FDCF5"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="DetailPlot" FontSize="14" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left"
                                       Margin="0,18,0,0" LineHeight="22"/>
                            <TextBlock x:Name="DetailCredits" FontSize="13" Classes="muted" TextWrapping="Wrap" MaxWidth="780"
                                       HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,24,0,-8">
                                <WrapPanel.Styles>
                                    <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="0,0,8,8"/></Style>
                                </WrapPanel.Styles>
                                <Button x:Name="PlayButton" Classes="primary" Padding="22,11" Click="PlayMovie_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Play}" FontSize="18"/>
                                        <TextBlock x:Name="PlayText" Text="Play" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StartOverButton" Padding="18,11" Click="StartOver_Click" IsVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Refresh}"/>
                                        <TextBlock Text="Play from start" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DownloadButton" Padding="18,11" Click="DownloadMovie_Click" ToolTip.Tip="Save it to watch without a connection">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="DownloadIcon" Classes="icon" Text="{x:Static local:Icons.Download}"/>
                                        <TextBlock x:Name="DownloadText" Text="Download" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveButton" Padding="18,11" Click="Save_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="SaveIcon" Classes="icon" Text="{x:Static local:Icons.Plus}"/>
                                        <TextBlock x:Name="SaveText" Text="My List" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TrailerButton" Padding="18,11" Click="Trailer_Click" IsVisible="False"
                                        ToolTip.Tip="Watch the trailer (opens in your browser)">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Trailer}"/>
                                        <TextBlock Text="Trailer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WatchedButton" Padding="18,11" Click="Watched_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="WatchedIcon" Classes="icon" Text="{x:Static local:Icons.Eye}"/>
                                        <TextBlock x:Name="WatchedText" Text="Mark as watched" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <ProgressBar x:Name="DetailProgress" Classes="thin" Width="300" HorizontalAlignment="Left" Margin="0,14,0,0" IsVisible="False"/>
                            <TextBlock x:Name="DetailStatus" Classes="muted" Margin="0,16,0,0" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="CastSection" Margin="0,30,0,0" IsVisible="False">
                        <TextBlock Text="Cast" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="CastList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="card" Width="96" Margin="0,0,14,12" Click="Actor_Click"
                                            ToolTip.Tip="{Binding Name, StringFormat='See {0}’s other films and shows in your playlist'}">
                                        <StackPanel>
                                            <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" HorizontalAlignment="Center" Background="{StaticResource Surface3Brush}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="144" svc:ImageLoader.Url="{Binding Photo}" IsVisible="{Binding HasPhoto}"/>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                       MaxHeight="32" Margin="0,7,0,0"/>
                                            <TextBlock Text="{Binding Role}" FontSize="11" Classes="muted" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid x:Name="SeriesPart" Margin="0,34,0,0" IsVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1040"/></Grid.ColumnDefinitions>
                        <StackPanel>
                        <DockPanel>
                        <Button x:Name="DownloadSeasonButton" DockPanel.Dock="Right" Padding="14,8" VerticalAlignment="Top" Click="DownloadSeason_Click"
                                ToolTip.Tip="Download every episode in this season">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static local:Icons.Download}"/>
                                <TextBlock x:Name="DownloadSeasonText" Text="Download season" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ItemsControl x:Name="SeasonList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Classes="chip" GroupName="Season" Content="{Binding Label}" IsCheckedChanged="Season_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </DockPanel>

                        <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ghost" Click="Episode_Click" Margin="0,0,0,4" Padding="10" HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="194,*,Auto">
                                            <Border Width="178" Height="100" HorizontalAlignment="Left" CornerRadius="8" ClipToBounds="True"
                                                    Background="{StaticResource Surface2Brush}">
                                                <Panel>
                                                    <TextBlock Classes="icon muted" Text="{x:Static local:Icons.Play}" FontSize="26" HorizontalAlignment="Center"/>
                                                    <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="260" svc:ImageLoader.Url="{Binding Image}"/>
                                                    <Border VerticalAlignment="Bottom" Height="5" Background="#99000000" IsVisible="{Binding HasProgress}">
                                                        <ProgressBar Classes="thin" Value="{Binding Progress, Mode=OneWay}" Margin="6,0" VerticalAlignment="Center" Height="3"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4"
                                                            Background="#CC111622" IsVisible="{Binding Watched}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Classes="icon" Text="{x:Static local:Icons.Check}" FontSize="11" Foreground="#4ADE80"/>
                                                            <TextBlock Text="Watched" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" FontSize="12" Classes="muted" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Plot}" FontSize="12" Classes="muted" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="36"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Classes="ghost" Margin="4,0,6,0" VerticalAlignment="Center" Click="EpisodeDownload_Click"
                                                    ToolTip.Tip="Download this episode">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Panel>
                                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Download}" IsVisible="{Binding !Downloaded}"/>
                                                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Check}" Foreground="#4ADE80" IsVisible="{Binding Downloaded}"/>
                                                    </Panel>
                                                    <TextBlock Text="{Binding DownloadText}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Panel>

    </Grid>
</UserControl>
