<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             xmlns:local="clr-namespace:Dingus"
             xmlns:views="clr-namespace:Dingus.Views"
             x:Class="Dingus.Views.StremioDetail">
        <!-- ===== Details ===== -->
        <Panel x:Name="DetailPane" Background="{StaticResource BgBrush}" ClipToBounds="True">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="460" Opacity="0.32" svc:ImageLoader.DecodeWidth="960"/>
            <Rectangle Height="460" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#400A0D13" Offset="0"/>
                        <GradientStop Color="#FF0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="40,20,40,40">
                    <Button Classes="ghost" HorizontalAlignment="Left" Click="Back_Click" Margin="-12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="{x:Static local:Icons.Back}"/>
                            <TextBlock x:Name="BackText" Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0" ColumnDefinitions="Auto,*">
                        <Border Width="200" Height="300" VerticalAlignment="Top" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                            <Image x:Name="DetailPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="300"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="32,4,0,0">
                            <TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailMeta" FontSize="14" Classes="muted" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPlot" FontSize="14" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,16,0,0" LineHeight="22"/>
                            <TextBlock x:Name="DetailCredits" FontSize="13" Classes="muted" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock x:Name="DetailStatus" Classes="muted" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="SeriesPart" IsVisible="False" Margin="0,26,0,0">
                        <TextBlock Classes="section" Text="EPISODES" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="SeasonList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Classes="chip" GroupName="StremioSeason" Content="{Binding}" IsCheckedChanged="Season_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0" Width="780" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ghost" Click="Episode_Click" Margin="0,0,0,4" Padding="10" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" Width="76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Panel DockPanel.Dock="Right" Margin="12,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Classes="icon muted" Text="{x:Static local:Icons.ChevronRight}" IsVisible="{Binding !Selected}"/>
                                                <TextBlock Classes="icon" Text="{x:Static local:Icons.Play}" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding Selected}"/>
                                            </Panel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Aired}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <views:StremioSources x:Name="Sources" Margin="0,26,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Panel>
</UserControl>
