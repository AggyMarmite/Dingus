<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dingus"
             x:Class="Dingus.Views.StremioSources">
    <UserControl.Resources>
        <!-- A source for a film or episode -->
        <DataTemplate x:Key="SourceRow">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ToolTip.Tip="{Binding Hint}">
                <DockPanel>
                    <Panel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Classes="primary" Click="Source_Click" Content="{Binding PlayText}" IsVisible="{Binding CanPlay}" IsEnabled="{Binding !Busy}"/>
                        <Button Content="{Binding PlayText}" IsVisible="{Binding !CanPlay}" IsEnabled="False"/>
                    </Panel>
                    <Button DockPanel.Dock="Right" Classes="ghost" Margin="12,0,0,0" VerticalAlignment="Center" Click="SourceDownload_Click"
                            ToolTip.Tip="Download this source to watch without a connection" IsVisible="{Binding CanDownload}" IsEnabled="{Binding !Saving}">
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Download}" FontSize="16"/>
                    </Button>
                    <Border DockPanel.Dock="Left" MinWidth="64" Height="30" CornerRadius="6" Background="{StaticResource Surface3Brush}" Padding="8,0"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Quality}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Width="770" HorizontalAlignment="Left">
        <TextBlock x:Name="SourcesHeader" Classes="section" Text="SOURCES" Margin="0,0,0,4"/>
        <TextBlock x:Name="SourcesStatus" Classes="muted" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource SourceRow}"/>
    </StackPanel>
</UserControl>
