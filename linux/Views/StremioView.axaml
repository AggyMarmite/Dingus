<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             xmlns:local="clr-namespace:Dingus"
             x:Class="Dingus.Views.StremioView">
    <UserControl.Resources>
        <!-- A film or show in a catalogue -->
        <DataTemplate x:Key="MetaCard">
            <Button Classes="card" Width="156" Margin="8,8,8,14" Click="Meta_Click" ToolTip.Tip="{Binding Title}">
                <StackPanel>
                    <Border Width="156" Height="234" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                        <Panel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12" VerticalAlignment="Center"
                                       Classes="muted" FontSize="12"/>
                            <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Classes="muted" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A source for a film or episode -->
        <DataTemplate x:Key="SourceRow">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ToolTip.Tip="{Binding Hint}">
                <DockPanel>
                    <Panel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Classes="primary" Click="Source_Click" Content="{Binding PlayText}" IsVisible="{Binding CanPlay}" IsEnabled="{Binding !Busy}"/>
                        <Button Content="{Binding PlayText}" IsVisible="{Binding !CanPlay}" IsEnabled="False"/>
                    </Panel>
                    <Button DockPanel.Dock="Right" Classes="ghost" Margin="12,0,0,0" VerticalAlignment="Center" Click="SourceDownload_Click"
                            ToolTip.Tip="Download this source to watch without a connection" IsVisible="{Binding CanDownload}" IsEnabled="{Binding !Saving}">
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Download}" FontSize="16"/>
                    </Button>
                    <Border DockPanel.Dock="Left" MinWidth="64" Height="30" CornerRadius="6" Background="{StaticResource Surface3Brush}" Padding="8,0"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Quality}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="232,*">

        <!-- ===== Catalogues ===== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="12,8,12,14" HorizontalAlignment="Left" Click="Manage_Click"
                        ToolTip.Tip="Sign in to Stremio, add add-ons, connect Real-Debrid">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Settings}"/>
                        <TextBlock Text="Add-ons &amp; Real-Debrid" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Text="CATALOGUES" Margin="20,18,0,8" FontSize="11" FontWeight="SemiBold" Classes="muted"/>
                <ListBox x:Name="CatalogList" Classes="clean categories" SelectionChanged="CatalogList_SelectionChanged" Padding="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding From}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Browse ===== -->
        <Grid x:Name="BrowsePane" Grid.Column="1" RowDefinitions="Auto,*">
            <DockPanel Margin="28,18,28,10">
                <Panel DockPanel.Dock="Right" Width="340" VerticalAlignment="Center">
                    <TextBox x:Name="QueryBox" Watermark="Search add-ons for films and shows" Padding="34,7,10,7" TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"/>
                    <TextBlock Classes="icon muted" Text="{x:Static local:Icons.Search}" FontSize="16" Margin="11,0,0,0" HorizontalAlignment="Left"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Panel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="Stremio" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" FontSize="13" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,3"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="BrowseScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="20,4,8,24">
                    <ItemsControl x:Name="MetaGrid" ItemTemplate="{StaticResource MetaCard}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="MoreButton" Content="Show more" HorizontalAlignment="Left" Margin="8,4,0,0" Click="More_Click" IsVisible="False"/>
                    <ItemsControl x:Name="RdList" Margin="8,0,20,0" MaxWidth="1000" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="primary" Content="Play" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Click="RdFile_Click" IsEnabled="{Binding !Busy}"/>
                                        <TextBlock DockPanel.Dock="Left" Classes="icon muted" Text="{x:Static local:Icons.FileVideo}" FontSize="20" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Margin="8,60,8,0" HorizontalAlignment="Center" MaxWidth="520" IsVisible="False">
                        <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyBody" Classes="muted" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="EmptyButton" Classes="primary" Content="Add-ons &amp; Real-Debrid" HorizontalAlignment="Center"
                                Margin="0,16,0,0" Click="Manage_Click" IsVisible="False"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Details ===== -->
        <Panel x:Name="DetailPane" Grid.Column="1" Background="{StaticResource BgBrush}" IsVisible="False" ClipToBounds="True">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="460" Opacity="0.32" svc:ImageLoader.DecodeWidth="960"/>
            <Rectangle Height="460" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#400A0D13" Offset="0"/>
                        <GradientStop Color="#FF0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="40,20,40,40">
                    <Button Classes="ghost" HorizontalAlignment="Left" Click="Back_Click" Margin="-12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="{x:Static local:Icons.Back}"/>
                            <TextBlock x:Name="BackText" Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0" ColumnDefinitions="Auto,*">
                        <Border Width="200" Height="300" VerticalAlignment="Top" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                            <Image x:Name="DetailPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="300"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="32,4,0,0">
                            <TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailMeta" FontSize="14" Classes="muted" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPlot" FontSize="14" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,16,0,0" LineHeight="22"/>
                            <TextBlock x:Name="DetailCredits" FontSize="13" Classes="muted" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock x:Name="DetailStatus" Classes="muted" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="SeriesPart" IsVisible="False" Margin="0,26,0,0">
                        <TextBlock Classes="section" Text="EPISODES" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="SeasonList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Classes="chip" GroupName="StremioSeason" Content="{Binding}" IsCheckedChanged="Season_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0" Width="780" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ghost" Click="Episode_Click" Margin="0,0,0,4" Padding="10" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" Width="76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Panel DockPanel.Dock="Right" Margin="12,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Classes="icon muted" Text="{x:Static local:Icons.ChevronRight}" IsVisible="{Binding !Selected}"/>
                                                <TextBlock Classes="icon" Text="{x:Static local:Icons.Play}" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding Selected}"/>
                                            </Panel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Aired}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="SourcesPart" Margin="0,26,0,0" Width="770" HorizontalAlignment="Left">
                        <TextBlock x:Name="SourcesHeader" Classes="section" Text="SOURCES" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SourcesStatus" Classes="muted" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource SourceRow}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
