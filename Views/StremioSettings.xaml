<UserControl x:Class="Dingus.Views.StremioSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="STREMIO ADD-ONS"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <!-- Stremio account -->
                <StackPanel x:Name="SignedOutPart">
                    <TextBlock Text="Sign in with Stremio" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap"
                               Text="Brings in the add-ons on your Stremio account. Your password isn't kept – only the sign-in Stremio gives back."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="EmailBox" Tag="Email" Width="230"/>
                        <Grid Width="200" Margin="8,0,0,0">
                            <PasswordBox x:Name="PasswordBox" KeyDown="Password_KeyDown" PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBlock x:Name="PasswordHint" Text="Password" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="13,0,0,0"/>
                        </Grid>
                        <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Content="Sign in" Margin="8,0,0,0" Click="SignIn_Click"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel x:Name="SignedInPart" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshAddonsButton" Style="{StaticResource BaseButton}" Content="Refresh add-ons" Click="RefreshAddons_Click"
                                ToolTip="Bring in add-ons you've added to your Stremio account since"/>
                        <Button Style="{StaticResource BaseButton}" Content="Sign out" Margin="8,0,0,0" Click="SignOut_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SignedInText" FontWeight="SemiBold"/>
                        <TextBlock Text="Your add-ons come from your Stremio account." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="AccountStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16"/>

                <!-- Add-ons -->
                <TextBlock Text="Your add-ons" FontWeight="SemiBold"/>
                <ItemsControl x:Name="AddonList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="AddonToggle_Click"
                                              ToolTip="Use this add-on"/>
                                    <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0" Click="AddonRemove_Click" ToolTip="Remove">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                                    </Button>
                                </StackPanel>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{StaticResource Surface2Brush}" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Margin="4" svc:ImageLoader.DecodeWidth="72" svc:ImageLoader.Url="{Binding Logo}"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="AddonUrlBox" Tag="Add-on address – https://…/manifest.json" Width="438" KeyDown="AddonUrl_KeyDown"/>
                    <Button x:Name="AddAddonButton" Style="{StaticResource BaseButton}" Content="Add" Margin="8,0,0,0" Click="AddAddon_Click"/>
                </StackPanel>
                <TextBlock x:Name="AddonStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Add-ons are made by other people. Dingus plays what they point to – make sure you have the right to watch it."/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="REAL-DEBRID"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <!-- not connected -->
                <StackPanel x:Name="RdOffPart">
                    <DockPanel>
                        <Button x:Name="RdConnectButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Connect" Click="RdConnect_Click"
                                VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Connect Real-Debrid" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,12,0" TextWrapping="Wrap"
                                       Text="Plays add-ons' torrent sources as ordinary streams, and lists the files in your Real-Debrid cloud. Needs a Real-Debrid premium account."/>
                        </StackPanel>
                    </DockPanel>
                    <!-- the code to enter -->
                    <Border x:Name="RdCodePart" Visibility="Collapsed" Margin="0,14,0,0" Padding="16,12" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Content="Open real-debrid.com" Click="RdOpen_Click"/>
                                <Button Style="{StaticResource BaseButton}" Content="Cancel" Margin="8,0,0,0" Click="RdCancel_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RdCodeHint" TextWrapping="Wrap" Text="On real-debrid.com/device, enter:"/>
                                <TextBlock x:Name="RdCode" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" FontFamily="Consolas"/>
                                <TextBlock Text="Waiting for you to confirm…" Foreground="#D9FFFFFF" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Content="Use an API token instead" HorizontalAlignment="Left" Margin="-10,10,0,0"
                            Padding="10,4" Click="RdTokenShow_Click"/>
                    <StackPanel x:Name="RdTokenPart" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <PasswordBox x:Name="RdTokenBox" Width="330"/>
                        <Button Style="{StaticResource BaseButton}" Content="Use token" Margin="8,0,0,0" Click="RdToken_Click"
                                ToolTip="Your private API token from real-debrid.com/apitoken"/>
                    </StackPanel>
                </StackPanel>
                <!-- connected -->
                <DockPanel x:Name="RdOnPart" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="Disconnect" Click="RdDisconnect_Click" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RdUserText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RdPremiumText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="RdStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
