<UserControl x:Class="Dingus.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Categories ===== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,16,0,6">
                    <RadioButton x:Name="ModeGrid" Style="{StaticResource Chip}" GroupName="GuideMode" Content="Guide" Tag="grid"
                                 IsChecked="True" Checked="Mode_Checked" ToolTip="The full TV guide grid"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="GuideMode" Content="On now" Tag="now"
                                 Checked="Mode_Checked" ToolTip="What's on right now"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="GuideMode" Content="Tonight" Tag="tonight"
                                 Checked="Mode_Checked" ToolTip="What's on this evening"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="GuideMode" Tag="find" Margin="0,8,0,0"
                                 Checked="Mode_Checked" ToolTip="Find a programme by name, on any channel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Find a programme"/>
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Margin="20,12,0,8" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"/>
                <ListBox x:Name="CategoryList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CategoryItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="CategoryList_SelectionChanged" Padding="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Guide ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero: live mini player + programme details -->
            <Grid Margin="22,18,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviewSlot" Width="416" Height="234" CornerRadius="8" Background="#000000">
                    <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pick a channel to preview" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="HeroPanel" Grid.Column="1" Margin="26,2,0,0" Visibility="Hidden">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="34" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                            <Image x:Name="HeroLogo" Margin="4" svc:ImageLoader.DecodeWidth="104"/>
                        </Border>
                        <TextBlock x:Name="HeroChannel" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="HeroTitle" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="HeroLive" Background="{StaticResource LiveBrush}" CornerRadius="4" Padding="7,1"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="HeroTime" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="HeroProgress" Style="{StaticResource ThinProgress}" Maximum="1" Width="300"
                                 HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock x:Name="HeroDesc" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               TextTrimming="WordEllipsis" MaxHeight="38" Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="HeroNext" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroVersions" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Merged channel – if one version stops working, the next one is tried automatically"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="WatchFull_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Watch full screen"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CatchupButton" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="Catchup_Click"
                                Visibility="Collapsed" ToolTip="Play this programme from the beginning (catch-up)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CatchupText" Text="Start over"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemindButton" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="Remind_Click"
                                Visibility="Collapsed" ToolTip="Get a pop-up a minute before it starts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RemindText" Text="Remind me"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="MultiView_Click"
                                ToolTip="Watch 4, 6 or 8 channels at once (V)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Multi-view"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FavButton" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="Fav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FavGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="FavText" Text="Favourite"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Timeline header -->
            <Grid x:Name="TimelineHeader" Grid.Row="1" Height="40" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="30" Height="30" FontSize="12"
                            ToolTip="Earlier" Click="Earlier_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Now" Padding="10,5" Click="Now_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="30" Height="30" FontSize="12"
                            ToolTip="Later" Click="Later_Click"/>
                    <TextBlock x:Name="DayText" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <Canvas x:Name="TimeHeader" Grid.Column="1" ClipToBounds="True"/>
            </Grid>

            <!-- Channel rows -->
            <ListBox x:Name="ChannelList" Grid.Row="2" Style="{StaticResource CleanList}"
                     ItemContainerStyle="{StaticResource GuideRowItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="1,1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     SelectionChanged="ChannelList_SelectionChanged"
                     MouseDoubleClick="ChannelList_MouseDoubleClick"
                     KeyDown="ChannelList_KeyDown" PreviewMouseRightButtonDown="List_RightDown">
                <ListBox.ContextMenu>
                    <ContextMenu Opened="Ctx_Opened">
                        <MenuItem x:Name="CtxRemind" Header="Remind me" Click="CtxRemind_Click"/>
                        <Separator x:Name="CtxRemindSep"/>
                        <MenuItem Header="Watch full screen" Click="WatchFull_Click"/>
                        <MenuItem Header="Watch in picture-in-picture" Click="Mini_Click"/>
                        <MenuItem Header="Add / remove favourite" Click="Fav_Click"/>
                        <Separator/>
                        <MenuItem Header="Match TV guide…" Click="MatchGuide_Click"/>
                        <MenuItem Header="Rename channel…" Click="Rename_Click"/>
                        <MenuItem Header="Hide channel" Click="Hide_Click"/>
                        <MenuItem Header="Edit channels (order, names, hidden)…" Click="EditChannels_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Margin="14,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="Star" Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="#FBBF24" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="56" Height="40" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Margin="4" svc:ImageLoader.DecodeWidth="112" svc:ImageLoader.Url="{Binding Logo}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" ToolTip="{Binding Name}" Margin="10,0,4,0"
                                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="48"/>
                            </Grid>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}" Margin="0,6" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="B" Width="{Binding Width}" Height="56" CornerRadius="6" Padding="10,7"
                                                BorderThickness="3,0,0,0" BorderBrush="{Binding GenreBrush}"
                                                Background="{StaticResource Surface2Brush}" Cursor="Hand"
                                                MouseLeftButtonUp="Block_MouseLeftButtonUp">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="CU" DockPanel.Dock="Left" Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" Margin="0,2,6,0" Foreground="#FBBF24" Visibility="Collapsed"
                                                               ToolTip="Catch-up available"/>
                                                    <TextBlock x:Name="RB" DockPanel.Dock="Left" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" Margin="0,2,6,0" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"
                                                               ToolTip="Reminder set"/>
                                                    <TextBlock x:Name="T" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanCatchup}" Value="True">
                                                <Setter TargetName="CU" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasReminder}" Value="True">
                                                <Setter TargetName="RB" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Now marker -->
            <Canvas x:Name="NowLayer" Grid.Row="1" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="NowLine" Width="2" Fill="{StaticResource LiveBrush}" Visibility="Collapsed"/>
            </Canvas>

            <!-- "On now" and "Tonight" lists (replace the grid while selected) -->
            <Grid x:Name="ListMode" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource SurfaceBrush}">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <TextBlock x:Name="ListTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ListSub" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="NowList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource GuideRowItem}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Item"
                             SelectionChanged="NowList_SelectionChanged" MouseDoubleClick="NowList_MouseDoubleClick"
                             KeyDown="NowList_KeyDown" PreviewMouseRightButtonDown="List_RightDown">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="Ctx_Opened">
                                <MenuItem x:Name="CtxRemind2" Header="Remind me" Click="CtxRemind_Click"/>
                                <Separator x:Name="CtxRemindSep2"/>
                                <MenuItem Header="Watch full screen" Click="WatchFull_Click"/>
                                <MenuItem Header="Watch in picture-in-picture" Click="Mini_Click"/>
                                <MenuItem Header="Add / remove favourite" Click="Fav_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding GenreBrush}" Margin="0,10" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeText}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SubTime}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="56" Height="40" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Row.Initials}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Margin="4" svc:ImageLoader.DecodeWidth="112" svc:ImageLoader.Url="{Binding Row.Logo}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="3" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Row.DisplayName}" ToolTip="{Binding Row.Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Text="{Binding Row.Number}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock x:Name="CU" DockPanel.Dock="Left" Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Margin="0,2,6,0" Foreground="#FBBF24" Visibility="Collapsed" ToolTip="Catch-up available"/>
                                            <TextBlock x:Name="RB" DockPanel.Dock="Left" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Margin="0,2,6,0" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" ToolTip="Reminder set"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Genre}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="P" Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                                     Height="3" Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter TargetName="P" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanCatchup}" Value="True">
                                        <Setter TargetName="CU" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasReminder}" Value="True">
                                        <Setter TargetName="RB" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="ListEmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ListEmptyBody" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyBody" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
