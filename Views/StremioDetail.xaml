<UserControl x:Class="Dingus.Views.StremioDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             xmlns:local="clr-namespace:Dingus.Views">
        <!-- ===== Details ===== -->
        <Grid x:Name="DetailPane" Background="{StaticResource BgBrush}" ClipToBounds="True">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="460" Opacity="0.32" svc:ImageLoader.DecodeWidth="960"/>
            <Rectangle Height="460" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400A0D13" Offset="0"/>
                        <GradientStop Color="#FF0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="40,20,40,40">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="-12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BackText" Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="200" Height="300" VerticalAlignment="Top">
                            <Grid.Clip><RectangleGeometry Rect="0,0,200,300" RadiusX="10" RadiusY="10"/></Grid.Clip>
                            <Border Background="{StaticResource Surface2Brush}"/>
                            <Image x:Name="DetailPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="300"/>
                        </Grid>
                        <StackPanel Margin="32,4,0,0">
                            <TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailMeta" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPlot" FontSize="14" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,16,0,0" LineHeight="22"/>
                            <TextBlock x:Name="DetailCredits" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="780"
                                       HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock x:Name="DetailStatus" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- a show's episodes -->
                    <StackPanel x:Name="SeriesPart" Visibility="Collapsed" Margin="0,26,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="EPISODES" Margin="0,0,0,10"/>
                        <ListBox x:Name="SeasonList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource ChipItem}"
                                 SelectionChanged="SeasonList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0" Width="780" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Click="Episode_Click" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" Width="76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Pick" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Aired}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="Pick" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Pick" Property="Text" Value="&#xE768;"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- sources -->
                    <local:StremioSources x:Name="Sources" Margin="0,26,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
</UserControl>
