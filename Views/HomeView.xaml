<UserControl x:Class="Dingus.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <UserControl.Resources>
        <!-- Channel card: logo, channel, programme, progress or start time -->
        <DataTemplate x:Key="ChannelCardTemplate">
            <Button Style="{StaticResource PosterCard}" Width="236" Margin="8,6,8,10" Click="Channel_Click" ToolTip="{Binding Row.Name}"
                    MouseRightButtonUp="Card_RightClick">
                <Border CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="104">
                            <Border CornerRadius="10,10,0,0" Background="{StaticResource Surface2Brush}"/>
                            <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Margin="34,18" svc:ImageLoader.DecodeWidth="200" svc:ImageLoader.Url="{Binding Logo}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border x:Name="SoonBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,2"
                                    CornerRadius="10" Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock Text="{Binding When}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <Border VerticalAlignment="Bottom" Height="3" Background="{Binding GenreBrush}"/>
                        </Grid>
                        <StackPanel Margin="14,10,14,12">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="Prog" Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                         Height="3" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="WhenText" Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                    <Setter TargetName="Prog" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter TargetName="SoonBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="WhenText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PosterCardTemplate">
            <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,6,8,10" Click="Poster_Click" ToolTip="{Binding Title}">
                <StackPanel>
                    <Grid Width="156" Height="234">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </Border>
                        <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="4" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,36">
            <TextBlock x:Name="Greeting" FontSize="26" FontWeight="SemiBold" Margin="8,14,0,2"/>
            <TextBlock x:Name="GreetingSub" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,6"/>

            <!-- Account status -->
            <Border x:Name="AccountStrip" Margin="8,10,8,0" Padding="14,9" CornerRadius="10" HorizontalAlignment="Left"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="AccountDot" Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AccountText" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Resume your last channel, with a live preview -->
            <Border x:Name="Banner" Margin="8,18,8,0" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Visibility="Collapsed" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BannerSlot" Width="384" Height="216" CornerRadius="8" Background="#000000">
                        <StackPanel x:Name="BannerPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Starting preview…" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,4,8,0" MinWidth="280" MaxWidth="520">
                        <TextBlock Text="CARRY ON WATCHING" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Width="52" Height="34" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                                <Image x:Name="BannerLogo" Margin="4" svc:ImageLoader.DecodeWidth="104"/>
                            </Border>
                            <TextBlock x:Name="BannerChannel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="BannerTitle" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerTime" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="BannerProgress" Style="{StaticResource ThinProgress}" Maximum="1" Width="260"
                                     HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock x:Name="BannerNext" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="BannerWatch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Watch full screen"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BaseButton}" Content="Open in guide" Margin="8,0,0,0" Click="BannerGuide_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coming up next on your channels -->
            <StackPanel x:Name="NextSection">
                <TextBlock Style="{StaticResource SectionHeader}" Text="COMING UP NEXT" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NextList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Live sport on now, across all channels -->
            <StackPanel x:Name="SportSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeader}" Text="LIVE SPORT NOW" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="SportList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Tonight's picks: films and sport starting this evening -->
            <StackPanel x:Name="RemindSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR REMINDERS" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="RemindList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="PicksSection" Visibility="Collapsed">
                <TextBlock x:Name="PicksHeader" Style="{StaticResource SectionHeader}" Text="TONIGHT'S PICKS" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="PicksList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Continue watching (films and episodes) -->
            <StackPanel x:Name="ResumeSection">
                <TextBlock Style="{StaticResource SectionHeader}" Text="CONTINUE WATCHING" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="ResumeList" ItemsPanel="{StaticResource RowPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,6,8,10" Click="Resume_Click" ToolTip="{Binding Title}">
                                    <StackPanel>
                                        <Grid Width="156" Height="234">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/>
                                            </Grid.Clip>
                                            <Border Background="{StaticResource Surface2Brush}">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </Border>
                                            <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                                            <Border VerticalAlignment="Bottom" Height="5" Background="#99000000">
                                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                                             Margin="8,0" VerticalAlignment="Center" Height="3"/>
                                            </Border>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46" CornerRadius="23"
                                                    Background="#99000000">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Recently watched channels -->
            <StackPanel x:Name="RecentSection">
                <TextBlock Style="{StaticResource SectionHeader}" Text="RECENTLY WATCHED" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="RecentList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Favourites -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="FAVOURITES" Margin="8,22,0,6"/>
            <ScrollViewer x:Name="FavScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="Row_PreviewMouseWheel">
                <ItemsControl x:Name="FavList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
            </ScrollViewer>
            <Border x:Name="FavEmpty" Style="{StaticResource Card}" Margin="8,4,8,0" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="No favourites yet" FontWeight="SemiBold"/>
                    <TextBlock Text="In the TV Guide, right-click a channel (or use the button on its details) and choose “Add to favourites”. They'll appear here with what's on now and next."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Newly added to your provider -->
            <StackPanel x:Name="NewFilmsSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeader}" Text="NEW FILMS" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NewFilmsList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource PosterCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="NewShowsSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeader}" Text="NEW TV SHOWS" Margin="8,22,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NewShowsList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource PosterCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
