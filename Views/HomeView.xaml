<UserControl x:Class="Dingus.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services"
             SizeChanged="Home_SizeChanged">
    <UserControl.Resources>
        <!-- Big white pill (Watch / More info) -->
        <Style x:Key="HeroPill" TargetType="Button">
            <Setter Property="Foreground" Value="#0B0E14"/>
            <Setter Property="Background" Value="#F4F6FA"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="G" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="25" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Hi" CornerRadius="25" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="G" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- See-through pill and round arrow button -->
        <Style x:Key="HeroGlass" TargetType="Button" BasedOn="{StaticResource HeroPill}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,0"/>
        </Style>
        <Style x:Key="HeroRound" TargetType="Button" BasedOn="{StaticResource HeroGlass}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="HeroLink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8,4">
                            <ContentPresenter x:Name="C" Opacity="0.85"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C9D0DC"/>
        </Style>

        <!-- Channel card: the logo on a tile in the logo's own colour, what's on, the channel -->
        <DataTemplate x:Key="ChannelCardTemplate">
            <Button Style="{StaticResource PosterCard}" Width="220" Margin="8,6,8,10" Click="Channel_Click" ToolTip="{Binding Row.Name}"
                    MouseRightButtonUp="Card_RightClick">
                <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <Grid Height="124">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,220,140" RadiusX="12" RadiusY="12"/>
                            </Grid.Clip>
                            <Border Background="{StaticResource Surface3Brush}"/>
                            <Border x:Name="Tint"/>
                            <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Margin="40,24" svc:ImageLoader.DecodeWidth="200" svc:ImageLoader.TintTarget="{Binding ElementName=Tint}"
                                   svc:ImageLoader.Url="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border x:Name="SoonBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,2"
                                    CornerRadius="10" Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock Text="{Binding When}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <ProgressBar x:Name="Prog" Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                         Foreground="White" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WhenText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}"/><Run x:Name="WhenRun" Text="{Binding WhenSuffix, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                    <Setter TargetName="Prog" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter TargetName="SoonBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PosterCardTemplate">
            <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,6,8,10" Click="Poster_Click" MouseRightButtonUp="Poster_RightUp"
                    ToolTip="{Binding Title}">
                <StackPanel>
                    <Grid Width="156" Height="234">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </Border>
                        <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="4" Background="{StaticResource AccentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
        <StackPanel>
            <!-- ================= Featured: a big picture with the title over it, a few slides that change by themselves ================= -->
            <Grid x:Name="Hero" Height="560" ClipToBounds="True" MouseEnter="Hero_MouseEnter" MouseLeave="Hero_MouseLeave">
                <Border Background="{StaticResource BgBrush}"/>
                <!-- The picture: built in code, one layer per slide, so a new picture fades in over the old one -->
                <Grid x:Name="HeroArt" IsHitTestVisible="False"/>
                <!-- Shading so the text reads, fading into the page at the bottom -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E60A0D13" Offset="0"/>
                            <GradientStop Color="#990A0D13" Offset="0.35"/>
                            <GradientStop Color="#000A0D13" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#660A0D13" Offset="0"/>
                            <GradientStop Color="#000A0D13" Offset="0.18"/>
                            <GradientStop Color="#000A0D13" Offset="0.5"/>
                            <GradientStop Color="#B30A0D13" Offset="0.82"/>
                            <GradientStop Color="#FF0A0D13" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel x:Name="HeroText" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="56,0,40,118" MaxWidth="720">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="HeroTextShift"/></StackPanel.RenderTransform>
                    <Border x:Name="HeroChip" HorizontalAlignment="Left" Padding="10,4" CornerRadius="6" Background="#99151A24"
                            BorderBrush="#26FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="HeroLabel" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="HeroTitle" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="52" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="136" LineHeight="64" LineStackingStrategy="BlockLineHeight"
                               Margin="0,12,0,0"/>
                    <TextBlock x:Name="HeroMeta" FontSize="15" FontWeight="SemiBold" Foreground="#E6EAF2" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="HeroProgress" Style="{StaticResource ThinProgress}" Maximum="1" Width="280" Height="4" Foreground="White"
                                 HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="HeroDesc" FontSize="14" Foreground="#D5DAE3" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               MaxWidth="620" HorizontalAlignment="Left" MaxHeight="62" LineHeight="20.5" LineStackingStrategy="BlockLineHeight" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="HeroPrimary" Style="{StaticResource HeroPill}" Click="HeroPrimary_Click" MinWidth="170">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HeroPrimaryIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="HeroPrimaryText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeroSecondary" Style="{StaticResource HeroGlass}" Click="HeroSecondary_Click" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HeroSecondaryIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="HeroSecondaryText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeroNext" Style="{StaticResource HeroRound}" Content="&#xE76C;" Click="HeroNext_Click" Margin="12,0,0,0" ToolTip="Next"/>
                    </StackPanel>
                </StackPanel>

                <!-- Which slide you're on -->
                <Border x:Name="HeroDotsBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,80" Padding="8,6" CornerRadius="10"
                        Background="#661A1F2B">
                    <ItemsControl x:Name="HeroDots">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="HeroDot_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Title}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="3,2"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Background="White" Opacity="0.5"/>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding On}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="18" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="6" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.35"/>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Account status -->
                <Border x:Name="AccountStrip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,28,0" Padding="12,7" CornerRadius="16"
                        Background="#99151A24" BorderBrush="#26FFFFFF" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AccountDot" Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="AccountText" FontSize="12" Foreground="#E6EAF2" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= Rows (they sit up into the bottom of the picture) ================= -->
            <StackPanel Margin="40,-74,40,40">
            <StackPanel x:Name="FavSection">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Favourite channels"/>
                    <Button Grid.Column="1" Style="{StaticResource HeroLink}" Content="View all" Tag="fav" Click="ViewAll_Click" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="FavList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <Border x:Name="FavEmpty" Style="{StaticResource Card}" Margin="8,4,8,0" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="No favourites yet" FontWeight="SemiBold"/>
                    <TextBlock Text="In Live TV, right-click a channel (or use the button on its details) and choose “Add to favourites”. They'll appear here with what's on now."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="ResumeSection">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Continue watching"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="ResumeList" ItemsPanel="{StaticResource RowPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,6,8,10" Click="Resume_Click" ToolTip="{Binding Title}">
                                    <StackPanel>
                                        <Grid Width="156" Height="234">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/>
                                            </Grid.Clip>
                                            <Border Background="{StaticResource Surface2Brush}">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </Border>
                                            <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                                            <Border VerticalAlignment="Bottom" Height="5" Background="#99000000">
                                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                                             Margin="8,0" VerticalAlignment="Center" Height="3"/>
                                            </Border>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46" CornerRadius="23"
                                                    Background="#99000000">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="MyListSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="My List"/>
                    <Button Grid.Column="1" Style="{StaticResource HeroLink}" Content="View all" Tag="mylist" Click="ViewAll_Click" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="MyListList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource PosterCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="NextSection">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Coming up next"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NextList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="SportSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Live sport now"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="SportList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="RemindSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Your reminders"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="RemindList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="PicksSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PicksHeader" Style="{StaticResource RowHeader}" Text="Tonight’s picks"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="PicksList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="RecentSection">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="Recently watched"/>
                    <Button Grid.Column="1" Style="{StaticResource HeroLink}" Content="View all" Tag="recent" Click="ViewAll_Click" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="RecentList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource ChannelCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="NewFilmsSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="New films"/>
                    <Button Grid.Column="1" Style="{StaticResource HeroLink}" Content="View all" Tag="films" Click="ViewAll_Click" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NewFilmsList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource PosterCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="NewShowsSection" Visibility="Collapsed">
                <Grid Margin="8,26,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeader}" Text="New TV shows"/>
                    <Button Grid.Column="1" Style="{StaticResource HeroLink}" Content="View all" Tag="shows" Click="ViewAll_Click" VerticalAlignment="Bottom"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Row_PreviewMouseWheel">
                    <ItemsControl x:Name="NewShowsList" ItemsPanel="{StaticResource RowPanel}" ItemTemplate="{StaticResource PosterCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
