<Window x:Class="Dingus.Views.ChannelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Dingus.Services"
        Title="Edit channels" Width="980" Height="680" MinWidth="760" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="24,16,16,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="Close_Click"
                        VerticalAlignment="Top" ToolTip="Close"/>
                <StackPanel>
                    <TextBlock Text="Edit channels" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Rename, hide and reorder channels. Changes save as you go and are kept when the playlist refreshes."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" Click="Close_Click" Padding="22,9"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BaseButton}" Content="Reset order of this category" Click="ResetOrder_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Show all hidden channels" Margin="8,0,0,0" Click="ShowAll_Click"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0">
                <ListBox x:Name="CategoryList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CategoryItem}"
                         Margin="0,8,0,0" SelectionChanged="Category_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Padding="20,14,20,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBox x:Name="FilterBox" Tag="Filter channels by name" TextChanged="Filter_TextChanged"/>
                    </DockPanel>
                </Border>
                <ListBox x:Name="RowList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource GuideRowItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item" KeyboardNavigation.TabNavigation="Continue">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" Margin="20,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Visible}" VerticalAlignment="Center" Margin="0"
                                          ToolTip="Show this channel in Live TV"/>
                                <Border Grid.Column="2" Width="50" Height="36" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Row.Initials}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Margin="4" svc:ImageLoader.DecodeWidth="100" svc:ImageLoader.Url="{Binding Row.Logo}"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="NameBox" Grid.Column="3" Margin="10,0" Padding="10,6" Tag="{Binding Row.OriginalName}"
                                         Text="{Binding Name, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                         ToolTip="{Binding Row.Channel.Name}"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="12" Width="30" Height="30"
                                            ToolTip="Use the provider's name" Click="ResetName_Click" Visibility="{Binding ResetVisibility}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" FontSize="12" Width="30" Height="30"
                                            ToolTip="Move to the top" Click="Top_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" Width="30" Height="30"
                                            ToolTip="Move up" Click="Up_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" Width="30" Height="30"
                                            ToolTip="Move down" Click="Down_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                    <Setter TargetName="NameBox" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
