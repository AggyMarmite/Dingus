<UserControl x:Class="Dingus.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <UserControl.Resources>
        <!-- A film or episode in Downloads -->
        <DataTemplate x:Key="DownloadRow">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12,10,16,10" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DlPlay" Style="{StaticResource PrimaryButton}" Content="Play" Margin="8,0,0,0" Click="DlPlay_Click" Visibility="Collapsed"/>
                        <Button x:Name="DlShow" Style="{StaticResource BaseButton}" Content="Show in folder" Margin="8,0,0,0" Click="DlShow_Click" Visibility="Collapsed"/>
                        <Button x:Name="DlPause" Style="{StaticResource BaseButton}" Content="Pause" Margin="8,0,0,0" Click="DlPause_Click" Visibility="Collapsed"/>
                        <Button x:Name="DlResume" Style="{StaticResource PrimaryButton}" Content="Resume" Margin="8,0,0,0" Click="DlResume_Click" Visibility="Collapsed"/>
                        <Button Style="{StaticResource GhostButton}" Content="{Binding RemoveText}" Margin="8,0,0,0" Click="DlRemove_Click"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Left" Width="44" Height="64" VerticalAlignment="Center">
                        <Grid.Clip><RectangleGeometry Rect="0,0,44,64" RadiusX="5" RadiusY="5"/></Grid.Clip>
                        <Border Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="88" svc:ImageLoader.Url="{Binding Image}"/>
                    </Grid>
                    <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Line2}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="DlBar" Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="4"
                                     Margin="0,7,0,0" MaxWidth="420" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        <TextBlock x:Name="DlStatus" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="DlPlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DlShow" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanPause}" Value="True">
                    <Setter TargetName="DlPause" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanResume}" Value="True">
                    <Setter TargetName="DlResume" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowBar}" Value="True">
                    <Setter TargetName="DlBar" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="DlStatus" Property="Foreground" Value="#EF4444"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
        <StackPanel Margin="36,16,36,48" MaxWidth="1000">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Downloads" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Films and episodes saved to watch without a connection. Press Download on a film, an episode or a season in Films, TV Shows or Stremio."/>
            </StackPanel>

            <TextBlock x:Name="ActiveHeader" Style="{StaticResource SectionHeader}" Text="DOWNLOADING"/>
            <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource DownloadRow}"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="DOWNLOADED"/>
            <ItemsControl x:Name="DoneList" ItemTemplate="{StaticResource DownloadRow}"/>
            <TextBlock x:Name="DoneEmpty" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap" Text="Nothing downloaded yet."/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="DOWNLOAD SETTINGS"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Save downloads to" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap"
                               Text="Films and episodes you download. Shows get a folder each, with a folder per season."/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BaseButton}" Content="Browse…" Margin="8,0,0,0" Click="DlBrowse_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Open" Margin="4,0,0,0" Click="DlOpenFolder_Click"/>
                        </StackPanel>
                        <TextBox x:Name="DlFolderBox" Tag="Folder or network path" LostFocus="DlFolderBox_LostFocus" KeyDown="DlFolderBox_KeyDown"/>
                    </DockPanel>
                    <TextBlock x:Name="DlFolderStatus" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="Dingus needs to be open for downloads to make progress – minimised is fine. If it's closed or the connection drops, a download carries on from where it stopped. Downloads from your playlist wait while you're watching if your plan only allows one connection at a time."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
