<UserControl x:Class="Dingus.Views.StremioSources"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A source for a film or episode -->
        <DataTemplate x:Key="SourceRow">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ToolTip="{Binding Hint}">
                <DockPanel>
                    <Button x:Name="PlayBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="Source_Click" Content="{Binding PlayText}"/>
                    <Button x:Name="DlBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="SourceDownload_Click" ToolTip="Download this source to watch without a connection" Visibility="Collapsed">
                        <TextBlock x:Name="DlIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                    <Border DockPanel.Dock="Left" MinWidth="64" Height="30" CornerRadius="6" Background="{StaticResource Surface3Brush}" Padding="8,0"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Quality}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanPlay}" Value="False">
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="PlayBtn" Property="Style" Value="{StaticResource BaseButton}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="PlayBtn" Property="Content" Value="Starting…"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanDownload}" Value="True">
                    <Setter TargetName="DlBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Saving}" Value="True">
                    <Setter TargetName="DlBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="DlIcon" Property="Text" Value="&#xE895;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel x:Name="Root" Width="770" HorizontalAlignment="Left">
        <TextBlock x:Name="SourcesHeader" Style="{StaticResource SectionHeader}" Text="SOURCES" Margin="0,0,0,4"/>
        <TextBlock x:Name="SourcesStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource SourceRow}"/>
    </StackPanel>
</UserControl>
