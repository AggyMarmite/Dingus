<UserControl x:Class="Dingus.Views.PlexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="PlexPoster">
            <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,8,8,14" Click="Item_Click" ToolTip="{Binding Title}">
                <StackPanel>
                    <Grid Width="156" Height="234">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </Border>
                        <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                        <Border x:Name="Prog" VerticalAlignment="Bottom" Height="5" Background="#99000000" Visibility="Collapsed">
                            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                         Margin="8,0" VerticalAlignment="Center" Height="3"/>
                        </Border>
                        <Border x:Name="Seen" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="22" Height="22" CornerRadius="11"
                                Background="#CC111622" Visibility="Collapsed" ToolTip="Watched">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#4ADE80"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                    <Setter TargetName="Prog" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Watched}" Value="True">
                    <Setter TargetName="Seen" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ===== Not signed in ===== -->
        <StackPanel x:Name="SignInPane" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="Collapsed">
            <Border Width="72" Height="72" CornerRadius="18" Background="#E5A00D" HorizontalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="#1F1F1F"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Border>
            <TextBlock Text="Watch your Plex library" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,22"
                       Text="Sign in once and your films and shows from your Plex server appear here, with your watch progress kept in step with Plex."/>
            <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Content="Sign in with Plex" HorizontalAlignment="Center"
                    Padding="26,12" Click="SignIn_Click"/>
            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,22,0,0">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Your browser has opened plex.tv – sign in there and allow Dingus. Or go to plex.tv/link on any device and enter:"/>
                <TextBlock x:Name="CodeText" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Waiting for Plex…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="12"/>
                <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,10,0,0" Click="CancelSignIn_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Signed in ===== -->
        <Grid x:Name="MainPane" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,16,8">
                        <TextBlock Text="PLEX SERVER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ServerText" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="LIBRARIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="LibraryList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CategoryItem}"
                             SelectionChanged="LibraryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Grid of films / shows -->
            <Grid x:Name="BrowsePane" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="28,18,28,10">
                    <StackPanel x:Name="SortChips" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource Chip}" Content="Recently added" Tag="added" Checked="Sort_Checked" IsChecked="True"/>
                        <RadioButton Style="{StaticResource Chip}" Content="A–Z" Tag="name" Checked="Sort_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Unwatched" Tag="unwatched" Checked="Sort_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Bottom" Padding="0,0,0,3"/>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="PosterList" Grid.Row="1" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource PlainItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" Padding="20,4,8,24" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" ItemTemplate="{StaticResource PlexPoster}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="BrowseStatus" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
            </Grid>

            <!-- A show: seasons and episodes -->
            <ScrollViewer x:Name="ShowPane" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,20,32,40">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="BackToLibrary_Click" Margin="-10,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BackText" Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="170" Height="255" VerticalAlignment="Top">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,170,255" RadiusX="10" RadiusY="10"/>
                            </Grid.Clip>
                            <Border Background="{StaticResource Surface2Brush}"/>
                            <Image x:Name="ShowPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="260"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock x:Name="ShowTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ShowMeta" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="ShowSummary" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20" Foreground="#D9FFFFFF"
                                       MaxHeight="120" TextTrimming="WordEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="SeasonList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource ChipItem}" Margin="0,28,0,0"
                             SelectionChanged="SeasonList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0" MaxWidth="1040" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Click="Item_Click" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="194"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="178" Height="100" HorizontalAlignment="Left">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,178,100" RadiusX="8" RadiusY="8"/>
                                            </Grid.Clip>
                                            <Border Background="{StaticResource Surface2Brush}">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="260" svc:ImageLoader.Url="{Binding Image}"/>
                                            <Border x:Name="EpProg" VerticalAlignment="Bottom" Height="5" Background="#99000000" Visibility="Collapsed">
                                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                                             Margin="6,0" VerticalAlignment="Center" Height="3"/>
                                            </Border>
                                            <Border x:Name="EpWatched" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                                    CornerRadius="4" Background="#CC111622" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#4ADE80"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Watched" FontSize="10" Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Index, Mode=OneTime}"/><Run Text=". "/><Run Text="{Binding Title, Mode=OneTime}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="36"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                        <Setter TargetName="EpProg" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Watched}" Value="True">
                                        <Setter TargetName="EpWatched" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
