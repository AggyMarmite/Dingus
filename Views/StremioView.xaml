<UserControl x:Class="Dingus.Views.StremioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Dingus.Services">
    <UserControl.Resources>
        <!-- A film or show in a catalogue -->
        <DataTemplate x:Key="MetaCard">
            <Button Style="{StaticResource PosterCard}" Width="156" Margin="8,8,8,14" Click="Meta_Click" ToolTip="{Binding Title}">
                <StackPanel>
                    <Grid Width="156" Height="234">
                        <Grid.Clip><RectangleGeometry Rect="0,0,156,234" RadiusX="8" RadiusY="8"/></Grid.Clip>
                        <Border Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </Border>
                        <Image Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="240" svc:ImageLoader.Url="{Binding Image}"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,9,2,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,3,2,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A source for a film or episode -->
        <DataTemplate x:Key="SourceRow">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ToolTip="{Binding Hint}">
                <DockPanel>
                    <Button x:Name="PlayBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="Source_Click" Content="{Binding PlayText}"/>
                    <Border DockPanel.Dock="Left" MinWidth="64" Height="30" CornerRadius="6" Background="{StaticResource Surface3Brush}" Padding="8,0"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Quality}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanPlay}" Value="False">
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="PlayBtn" Property="Style" Value="{StaticResource BaseButton}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="PlayBtn" Property="Content" Value="Starting…"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Catalogues ===== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Margin="12,8,12,14" HorizontalAlignment="Left" Click="Manage_Click"
                        ToolTip="Sign in to Stremio, add add-ons, connect Real-Debrid">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Add-ons &amp; Real-Debrid"/>
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Text="CATALOGUES" Margin="20,18,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <ListBox x:Name="CatalogList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CategoryItem}"
                         SelectionChanged="CatalogList_SelectionChanged" Padding="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding From}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Browse ===== -->
        <Grid x:Name="BrowsePane" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="28,18,28,10">
                <Grid DockPanel.Dock="Right" Width="340" VerticalAlignment="Center">
                    <TextBox x:Name="QueryBox" Tag="Search add-ons for films and shows" Padding="34,7,10,7" TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="Stremio" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,3"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="BrowseScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="20,4,8,24">
                    <!-- catalogue / search results -->
                    <ItemsControl x:Name="MetaGrid" ItemTemplate="{StaticResource MetaCard}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="MoreButton" Style="{StaticResource BaseButton}" Content="Show more" HorizontalAlignment="Left" Margin="8,4,0,0"
                            Click="More_Click" Visibility="Collapsed"/>
                    <!-- your Real-Debrid files -->
                    <ItemsControl x:Name="RdList" Margin="8,0,20,0" MaxWidth="1000" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <Button x:Name="PlayBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Play" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Click="RdFile_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,0,14,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="PlayBtn" Property="Content" Value="Starting…"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Margin="8,60,8,0" HorizontalAlignment="Center" MaxWidth="520" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyBody" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="EmptyButton" Style="{StaticResource PrimaryButton}" Content="Add-ons &amp; Real-Debrid" HorizontalAlignment="Center"
                                Margin="0,16,0,0" Click="Manage_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Details ===== -->
        <Grid x:Name="DetailPane" Grid.Column="1" Background="{StaticResource BgBrush}" Visibility="Collapsed" ClipToBounds="True">
            <Image x:Name="DetailBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" Height="460" Opacity="0.32" svc:ImageLoader.DecodeWidth="960"/>
            <Rectangle Height="460" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400A0D13" Offset="0"/>
                        <GradientStop Color="#FF0A0D13" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                <StackPanel Margin="40,20,40,40">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="-12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BackText" Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="200" Height="300" VerticalAlignment="Top">
                            <Grid.Clip><RectangleGeometry Rect="0,0,200,300" RadiusX="10" RadiusY="10"/></Grid.Clip>
                            <Border Background="{StaticResource Surface2Brush}"/>
                            <Image x:Name="DetailPoster" Stretch="UniformToFill" svc:ImageLoader.DecodeWidth="300"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="32,4,0,0">
                            <TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailMeta" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPlot" FontSize="14" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" Margin="0,16,0,0" LineHeight="22"/>
                            <TextBlock x:Name="DetailCredits" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="780"
                                       HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock x:Name="DetailStatus" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- a show's episodes -->
                    <StackPanel x:Name="SeriesPart" Visibility="Collapsed" Margin="0,26,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="EPISODES" Margin="0,0,0,10"/>
                        <ListBox x:Name="SeasonList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource ChipItem}"
                                 SelectionChanged="SeasonList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl x:Name="EpisodeList" Margin="-10,10,0,0" Width="780" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Click="Episode_Click" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" Width="76" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Pick" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Aired}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="Pick" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Pick" Property="Text" Value="&#xE768;"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- sources -->
                    <StackPanel x:Name="SourcesPart" Margin="0,26,0,0" Width="770" HorizontalAlignment="Left">
                        <TextBlock x:Name="SourcesHeader" Style="{StaticResource SectionHeader}" Text="SOURCES" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SourcesStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource SourceRow}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
