<Window x:Class="Dingus.Views.PlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,22,28,24">
        <DockPanel x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="Cancel_Click"
                    Margin="0,-6,-12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="HeaderText" Text="Add playlist" FontSize="20" FontWeight="SemiBold"/>
        </DockPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Type"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TypeXtream" Style="{StaticResource Chip}" Content="Xtream Codes login" Checked="Type_Checked"/>
            <RadioButton x:Name="TypeM3u" Style="{StaticResource Chip}" Content="M3U link or file" Checked="Type_Checked"/>
            <RadioButton x:Name="TypeStremio" Style="{StaticResource Chip}" Content="Stremio" Checked="Type_Checked"/>
        </StackPanel>

        <StackPanel x:Name="NamePanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Playlist name"/>
            <TextBox x:Name="NameBox" Tag="e.g. Home, Sport, Backup"/>
        </StackPanel>

        <StackPanel x:Name="XtreamPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Server address"/>
            <TextBox x:Name="ServerBox" Tag="http://provider.example:8080"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                    <TextBox x:Name="UserBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                    <PasswordBox x:Name="PassBox"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="M3uPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="M3U address (or a file path on this PC)"/>
            <TextBox x:Name="M3uBox" Tag="http://provider.example/get.php?username=…&amp;type=m3u_plus"/>
        </StackPanel>

        <StackPanel x:Name="StremioPanel" Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Your Stremio add-ons' films and shows appear in Films and TV Shows, and their sources under your playlist's titles too."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Stremio email"/>
                    <TextBox x:Name="StremioEmailBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                    <PasswordBox x:Name="StremioPassBox"/>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="…or an add-on's address (optional)"/>
            <TextBox x:Name="StremioUrlBox" Tag="https://…/manifest.json or stremio://…"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Your password is only used to sign in – Dingus doesn't keep it. Connect Real-Debrid afterwards in Settings to play torrent sources."/>
        </StackPanel>

        <StackPanel x:Name="EpgPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="TV guide address (optional)"/>
            <TextBox x:Name="EpgBox" Tag="Leave empty to use the provider's guide"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0" MinWidth="110"
                    Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
