<Window x:Class="Dingus.Views.GuideMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match TV guide" Width="640" Height="620" MinWidth="520" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="Cancel_Click"
                    VerticalAlignment="Top" Margin="0,-6,-10,0"/>
            <StackPanel>
                <TextBlock Text="Match TV guide" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="ForText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CurrentText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" Content="No guide for this channel" Click="NoGuide_Click" Margin="0,0,8,0"
                    ToolTip="Stop showing guide data for this channel"/>
            <Button Style="{StaticResource GhostButton}" Content="Match automatically" Click="Auto_Click" Margin="0,0,8,0"
                    ToolTip="Forget your choice and let Dingus match it"/>
            <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Content="Use this guide" Click="Use_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Tag="Search the guide's channels" Margin="0,16,0,10" TextChanged="Search_TextChanged"/>
        <TextBlock DockPanel.Dock="Top" x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,8"/>

        <ListBox x:Name="SourceList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource GuideRowItem}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionChanged="SourceList_SelectionChanged" MouseDoubleClick="SourceList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="14,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Now}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
