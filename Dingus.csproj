<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dingus</AssemblyName>
    <RootNamespace>Dingus</RootNamespace>
    <Product>Dingus</Product>
    <Version>0.9.7</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dingus.ico</ApplicationIcon>

    <!-- 64-bit only keeps the VLC payload to one architecture -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Low resource use: workstation, non-concurrent GC, no background GC thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Background GC: most memory clean-up runs alongside the app instead of pausing the window
         (with 100,000+ titles a full pause can be over a second). -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Releases ship Dingus's code already compiled for the PC, so it starts and draws its first pages faster
         (otherwise .NET compiles it while you wait, the first time each part is used). -->
    <PublishReadyToRun Condition="'$(_IsPublishing)' == 'true'">true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ask the .NET garbage collector to favour a small memory footprint over raw speed (0-9). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Give freed memory back to Windows instead of keeping it reserved for later. -->
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <!-- The VLC video surface is hosted in a WinForms panel, so reference WinForms,
       but keep its namespaces out of the global usings to avoid name clashes with WPF. -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms-only advice; this is a WPF app, which reads DPI awareness from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF projects drop System.IO from the implicit usings; the app needs it everywhere. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test projects live under tests/ and build separately. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
    <!-- The Linux app (Avalonia) builds separately. -->
    <Compile Remove="linux/**" />
    <None Remove="linux/**" />
    <Page Remove="linux/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Dingus.ico" />
  </ItemGroup>


  <!-- Smaller download: 64-bit VLC only, without the parts of VLC that Dingus never uses (recording/streaming out,
       encoders, discs, capture devices, visualisations).
       Every codec, HTTPS, HLS/DASH, subtitles (incl. teletext), deinterlacing and GPU decoding stay. -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="plugins\access_output\%2A;plugins\stream_out\%2A;plugins\mux\%2A;plugins\visualization\%2A;plugins\video_splitter\%2A;plugins\lua\%2A;plugins\services_discovery\%2A;plugins\meta_engine\%2A;plugins\stream_extractor\%2A;plugins\access\libdcp_plugin.dll;plugins\access\liblibbluray_plugin.dll;plugins\access\libdtv_plugin.dll;plugins\access\libdvdnav_plugin.dll;plugins\access\libdvdread_plugin.dll;plugins\access\libvcd_plugin.dll;plugins\access\libcdda_plugin.dll;plugins\access\libscreen_plugin.dll;plugins\access\libdshow_plugin.dll;plugins\access\libaccess_srt_plugin.dll;plugins\access\libsmb_plugin.dll;plugins\access\libvnc_plugin.dll;plugins\access\librdp_plugin.dll;plugins\access\libsftp_plugin.dll;plugins\access\libnfs_plugin.dll;plugins\access\libaccess_mms_plugin.dll;plugins\access\libsatip_plugin.dll;plugins\access\libdvb_plugin.dll;plugins\codec\libvpx_plugin.dll;plugins\codec\libaom_plugin.dll;plugins\demux\libgme_plugin.dll;plugins\video_output\libcaca_plugin.dll;plugins\audio_filter\libspatialaudio_plugin.dll;plugins\spu\libremoteosd_plugin.dll;plugins\spu\librss_plugin.dll;plugins\spu\libmosaic_plugin.dll;plugins\codec\libx264_plugin.dll;plugins\codec\libx26410b_plugin.dll;plugins\codec\libx265_plugin.dll;plugins\codec\libtwolame_plugin.dll;plugins\codec\libshine_plugin.dll;plugins\access\libbluray-j2se-1.3.2.jar" />
    <VlcWindowsX86IncludeFiles Remove="@(VlcWindowsX86IncludeFiles)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
