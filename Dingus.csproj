<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dingus</AssemblyName>
    <RootNamespace>Dingus</RootNamespace>
    <Product>Dingus</Product>
    <Version>0.3.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dingus.ico</ApplicationIcon>

    <!-- 64-bit only keeps the VLC payload to one architecture -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Low resource use: workstation, non-concurrent GC, no background GC thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ask the .NET garbage collector to favour a small memory footprint over raw speed (0-9). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Give freed memory back to Windows instead of keeping it reserved for later. -->
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <!-- The VLC video surface is hosted in a WinForms panel, so reference WinForms,
       but keep its namespaces out of the global usings to avoid name clashes with WPF. -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms-only advice; this is a WPF app, which reads DPI awareness from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF projects drop System.IO from the implicit usings; the app needs it everywhere. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test projects live under tests/ and build separately. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Dingus.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
