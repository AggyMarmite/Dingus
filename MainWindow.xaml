<Window x:Class="Dingus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:svc="clr-namespace:Dingus.Services"
        Title="Dingus" Icon="Assets/Dingus.ico" Width="1280" Height="760" MinWidth="960" MinHeight="560"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">

        <!-- ================= App shell ================= -->
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Top" Width="42" Height="42" Margin="0,16,0,18" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#60A5FA" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <RadioButton x:Name="NavHome" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Home" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavGuide" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Guide" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavFilms" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Tag="&#xE8B2;" Content="Films" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavShows" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="TV Shows" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 Checked="Nav_Checked" Margin="0,0,0,12"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="24,0,14,0">
                        <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BusyPanel" VerticalAlignment="Center" Margin="0,0,12,0" Padding="12,6,14,6" CornerRadius="16"
                                    Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Foreground="#93C5FD"
                                               RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform x:Name="BusyRotate"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="BusyTitle" Text="Refreshing playlist" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BusyText" Margin="8,0,0,0" Foreground="#AFC4E8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="PlaylistButton" Style="{StaticResource GhostButton}" Click="PlaylistButton_Click" ToolTip="Switch playlist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="PlaylistName" Margin="8,0,8,0" VerticalAlignment="Center" MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LockButton" Style="{StaticResource IconButton}" Content="&#xE72E;" Margin="4,0,0,0"
                                    Visibility="Collapsed" Click="Lock_Click"/>
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="4,0,0,0"
                                    ToolTip="Refresh playlist and TV guide" Click="Refresh_Click"/>
                        </StackPanel>

                        <Grid x:Name="SearchHost" Width="340" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Tag="Search" Padding="34,8,12,8" TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="13,0,0,0"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

                <!-- First run -->
                <!-- First load: nothing saved yet, so show a proper loading screen -->
                <Grid x:Name="LoadingOverlay" Grid.Row="1" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Grid Width="60" Height="60" HorizontalAlignment="Center">
                            <Ellipse Stroke="{StaticResource Surface3Brush}" StrokeThickness="5"/>
                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="5" StrokeDashArray="9 30"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="Loading playlist" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                        <TextBlock x:Name="LoadingStep" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LoadingHint" Text="Large playlists can take a minute the first time."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
                        <Button x:Name="LoadingSkip" Style="{StaticResource BaseButton}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                Content="Use saved channels" Visibility="Collapsed" Click="LoadingSkip_Click"
                                ToolTip="Start watching now – the playlist keeps refreshing in the background"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Welcome" Grid.Row="1" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                        <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#60A5FA" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Welcome to Dingus" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock Text="Add your IPTV playlist to get started. Xtream Codes logins and M3U links are both supported."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,12,0,26"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Add playlist" HorizontalAlignment="Center" Padding="26,12"
                                Click="AddPlaylist_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="18,11"
                CornerRadius="10" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>

        <!-- Keyboard shortcuts (? or F1) -->
        <Border x:Name="ShortcutSheet" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22,28,24" CornerRadius="14"
                Background="{StaticResource Surface2Brush}" BorderBrush="#22FFFFFF" BorderThickness="1" Visibility="Collapsed" MaxWidth="900"
                MouseLeftButtonDown="Sheet_MouseDown">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="? or Esc to close" Foreground="#99FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Keyboard shortcuts" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </DockPanel>
                <UniformGrid x:Name="ShortcutSheetGrid" Columns="2"/>
            </StackPanel>
        </Border>

        <!-- Channel number being typed (Guide) -->
        <Border x:Name="NumberBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,28,0" Padding="20,8"
                CornerRadius="10" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="NumberText" FontSize="30" FontWeight="SemiBold"/>
        </Border>

        <!-- ================= Video (mini player in the Guide, full window, or floating mini player) ================= -->
        <vlc:VideoView x:Name="Video" HorizontalAlignment="Left" VerticalAlignment="Top" Width="2" Height="2" Margin="-4,-4,0,0"
                       Background="Black">
            <Grid x:Name="Overlay" Background="#01000000" Focusable="True" TextElement.FontFamily="{StaticResource UiFont}"
                  MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseWheel="Overlay_MouseWheel"
                  MouseLeave="Overlay_MouseLeave" Loaded="Overlay_Loaded">

                <TextBlock x:Name="BufferText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Foreground="White" Visibility="Collapsed" TextAlignment="Center"/>

                <!-- Controls on the Guide / Home preview -->
                <Border x:Name="PreviewHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="2"
                        CornerRadius="8" Background="#99000000" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviewPlayPause" Style="{StaticResource OverlayIconButton}" Width="32" Height="32" FontSize="13" Margin="0"
                                Content="&#xE769;" ToolTip="Pause" Click="PlayPause_Click"/>
                        <Button Style="{StaticResource OverlayIconButton}" Width="32" Height="32" FontSize="13" Margin="0"
                                Content="&#xE8A7;" ToolTip="Picture-in-picture (P)" Click="PreviewPip_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OverlayToast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0" Padding="18,10"
                        CornerRadius="10" Background="#CC111622" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="OverlayToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
                </Border>

                <!-- Channel number being typed (player) -->
                <Border x:Name="OverlayNumberBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,32,0" Padding="22,8"
                        CornerRadius="10" Background="#CC111622" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="OverlayNumberText" FontSize="40" FontWeight="SemiBold" Foreground="White"/>
                </Border>

                <!-- Stream health (pinned with the I key, or shown with the controls) -->
                <Border x:Name="HealthBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,28,0" Padding="12,7"
                        CornerRadius="8" Background="#B0111622" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HealthDot" Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="HealthText" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Up next (end of an episode) -->
                <Border x:Name="UpNextCard" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,150" Padding="20,16"
                        CornerRadius="12" Background="#E6111622" BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed"
                        Width="360">
                    <StackPanel>
                        <TextBlock x:Name="UpNextCountdown" Text="Up next" Foreground="#AAB4C6" FontSize="12"/>
                        <TextBlock x:Name="UpNextTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="UpNextPlay_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Play now"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Foreground="White" Margin="8,0,0,0" Click="UpNextCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Floating mini player controls -->
                <Grid x:Name="MiniChrome" Visibility="Collapsed">
                    <Border VerticalAlignment="Top" Height="44">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#C0000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel Margin="10,0,4,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource OverlayIconButton}" Width="34" Height="34" FontSize="13" Content="&#xE740;"
                                        ToolTip="Full screen" Click="MiniExpand_Click"/>
                                <Button Style="{StaticResource OverlayIconButton}" Width="34" Height="34" FontSize="12" Content="&#xE8BB;"
                                        ToolTip="Close picture-in-picture – back to the app" Click="MiniClose_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniTitle" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <Button x:Name="MiniPlayPause" Style="{StaticResource OverlayIconButton}" Content="&#xE769;" FontSize="22" Width="52" Height="52"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="#80000000" Click="PlayPause_Click"/>
                    <!-- Drag to resize (keeps 16:9) -->
                    <Thumb x:Name="PipGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="26" Height="26" Cursor="SizeNWSE"
                           DragDelta="PipGrip_DragDelta" DragCompleted="PipGrip_DragCompleted" ToolTip="Drag to resize">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#01000000">
                                    <Path Data="M 20,6 L 6,20 M 20,12 L 12,20 M 20,18 L 18,20" Stroke="#CCFFFFFF" StrokeThickness="1.5"/>
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>

                <Grid x:Name="PlayerChrome" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Border Padding="24,20,28,56">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D0000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource OverlayIconButton}" Content="&#xE72B;" VerticalAlignment="Top"
                                    ToolTip="Back (Esc)" Click="Back_Click"/>
                            <Border x:Name="ChromeLogoBox" DockPanel.Dock="Left" Width="64" Height="44" CornerRadius="6" Margin="10,0,0,0"
                                    Background="#33FFFFFF" VerticalAlignment="Top">
                                <Image x:Name="ChromeLogo" Margin="5" svc:ImageLoader.DecodeWidth="128"/>
                            </Border>
                            <StackPanel Margin="14,0,240,0">
                                <TextBlock x:Name="ChromeTitle" FontSize="22" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ChromeSubtitle" FontSize="14" Foreground="#E6FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ChromeNext" FontSize="13" Foreground="#AAFFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom controls -->
                    <Border Grid.Row="2" Padding="28,64,28,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#D8000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid x:Name="SeekRow" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PosText" Text="0:00" Foreground="White" FontSize="13" VerticalAlignment="Center" MinWidth="48"/>
                                <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource PlayerSlider}" Margin="12,0" Minimum="0" Maximum="1"
                                        IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp"/>
                                <TextBlock x:Name="LenText" Grid.Column="2" Text="0:00" Foreground="White" FontSize="13" VerticalAlignment="Center"
                                           MinWidth="48" TextAlignment="Right"/>
                            </Grid>

                            <Grid x:Name="LiveRow" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LiveBadge" Background="{StaticResource LiveBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                        ToolTip="Live">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <ProgressBar x:Name="LiveProgress" Grid.Column="1" Style="{StaticResource ThinProgress}" Maximum="1" Margin="14,0"
                                             VerticalAlignment="Center"/>
                                <!-- Scrub bar: back through the rewind buffer / catch-up, forward up to live -->
                                <Slider x:Name="LiveSeek" Grid.Column="1" Style="{StaticResource PlayerSlider}" Margin="12,0" Minimum="0" Maximum="1"
                                        IsMoveToPointEnabled="True" Visibility="Collapsed" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="LiveSeek_MouseDown" PreviewMouseLeftButtonUp="LiveSeek_MouseUp"
                                        ValueChanged="LiveSeek_ValueChanged"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="GoLiveButton" Style="{StaticResource OverlayIconButton}" Width="Auto" Height="28" Padding="12,0"
                                            Margin="0,0,12,0" Visibility="Collapsed" ToolTip="Catch up to live (End)" Click="GoLive_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Go live" FontFamily="{StaticResource UiFont}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="LiveTimes" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource OverlayIconButton}" Content="&#xE769;"
                                            ToolTip="Play / pause (Space)" Click="PlayPause_Click"/>
                                    <Button x:Name="BackSeekButton" Style="{StaticResource OverlayIconButton}" Content="&#xE892;"
                                            ToolTip="Back 10 seconds (←)" Click="SeekBack_Click"/>
                                    <Button x:Name="FwdSeekButton" Style="{StaticResource OverlayIconButton}" Content="&#xE893;"
                                            ToolTip="Forward 30 seconds (→)" Click="SeekFwd_Click"/>
                                    <Button x:Name="ChUpButton" Style="{StaticResource OverlayIconButton}" Content="&#xE70E;"
                                            ToolTip="Previous channel in the list (↑)" Click="ChUp_Click"/>
                                    <Button x:Name="ChDownButton" Style="{StaticResource OverlayIconButton}" Content="&#xE70D;"
                                            ToolTip="Next channel in the list (↓)" Click="ChDown_Click"/>
                                    <Button x:Name="ChannelsButton" Style="{StaticResource OverlayIconButton}" Content="&#xE8FD;"
                                            ToolTip="Channel list – what's on now (Enter or L)" Click="Channels_Click"/>
                                    <Button x:Name="MultiViewButton" Style="{StaticResource OverlayIconButton}" Content="&#xE8A9;"
                                            ToolTip="Multi-view – watch 4, 6 or 8 channels at once (V)" Click="MultiView_Click"/>
                                    <Button x:Name="LastChButton" Style="{StaticResource OverlayIconButton}" Content="&#xE7A7;"
                                            ToolTip="Back to the last channel (0 or Backspace)" Click="LastCh_Click"/>
                                    <Button x:Name="NextEpisodeButton" Style="{StaticResource OverlayIconButton}"
                                            Visibility="Collapsed" Width="Auto" Padding="12,0" Click="NextEpisode_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Next episode" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SleepButton" Style="{StaticResource OverlayIconButton}" Content="&#xE708;"
                                            ToolTip="Sleep timer (S)" Click="Sleep_Click"/>
                                    <Button x:Name="InfoButton" Style="{StaticResource OverlayIconButton}" Content="&#xE946;"
                                            ToolTip="Stream info (I)" Click="Info_Click"/>
                                    <Button x:Name="QualityButton" Style="{StaticResource OverlayIconButton}" Content="&#xE7F4;"
                                            ToolTip="Version / quality" Click="Quality_Click" Visibility="Collapsed"/>
                                    <Button x:Name="PictureButton" Style="{StaticResource OverlayIconButton}" Content="&#xE790;"
                                            ToolTip="Picture &amp; sound – aspect ratio, crop, audio sync, night mode" Click="Picture_Click"/>
                                    <Button x:Name="AudioButton" Style="{StaticResource OverlayIconButton}" Content="&#xE8D6;"
                                            ToolTip="Audio track" Click="Audio_Click"/>
                                    <Button x:Name="SubsButton" Style="{StaticResource OverlayIconButton}" Content="&#xE7F0;"
                                            ToolTip="Subtitles" Click="Subs_Click"/>
                                    <Button x:Name="MuteButton" Style="{StaticResource OverlayIconButton}" Content="&#xE767;"
                                            ToolTip="Mute (M)" Click="Mute_Click"/>
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="110" Minimum="0" Maximum="100"
                                            VerticalAlignment="Center" Margin="4,0,12,0" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed"/>
                                    <Button x:Name="MiniButton" Style="{StaticResource OverlayIconButton}" Content="&#xE8A7;"
                                            ToolTip="Picture-in-picture (P)" Click="Mini_Click"/>
                                    <Button x:Name="FullscreenButton" Style="{StaticResource OverlayIconButton}" Content="&#xE73F;"
                                            ToolTip="Exit full screen – back to the guide (Esc)" Click="Fullscreen_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- In-player channel list: what's on now, change channel without leaving full screen -->
                <Border x:Name="ChannelPanel" HorizontalAlignment="Left" Width="460" Visibility="Collapsed"
                        Background="#F00C1018" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0"
                        MouseLeftButtonDown="ChannelPanel_MouseLeftButtonDown">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14,22,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource OverlayIconButton}" Content="&#xE76B;" FontSize="13" ToolTip="Previous category (←)"
                                    Click="PanelPrevCat_Click"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PanelCategory" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PanelCount" Foreground="#8B94A7" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource OverlayIconButton}" Content="&#xE76C;" FontSize="13"
                                    ToolTip="Next category (→)" Click="PanelNextCat_Click"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Text="↑ ↓ choose  ·  Enter watch  ·  ← → category  ·  Esc close"
                                   Foreground="#8B94A7" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,14"/>
                        <ListBox x:Name="PanelList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CategoryItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Item" Focusable="False"
                                 PreviewMouseLeftButtonUp="PanelList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Foreground="#8B94A7" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="50" Height="34" CornerRadius="5" Background="#1AFFFFFF">
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}" Foreground="#8B94A7" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Margin="3" svc:ImageLoader.DecodeWidth="100" svc:ImageLoader.Url="{Binding Logo}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="10,0,4,0" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock x:Name="Playing" DockPanel.Dock="Right" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="10" Foreground="#60A5FA" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Now}" Foreground="#AAB4C6" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneTime}"
                                                         Height="2" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Playing" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Keyboard shortcuts over the video -->
                <Border x:Name="OverlaySheet" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22,28,24" CornerRadius="14"
                        Background="#F20C1018" BorderBrush="#22FFFFFF" BorderThickness="1" Visibility="Collapsed" MaxWidth="900"
                        MouseLeftButtonDown="Sheet_MouseDown">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="? or Esc to close" Foreground="#99FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Keyboard shortcuts" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        </DockPanel>
                        <UniformGrid x:Name="OverlaySheetGrid" Columns="2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
